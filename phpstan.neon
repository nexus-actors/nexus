includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/shipmonk/phpstan-rules/rules.neon

parameters:
    level: 9
    phpVersion: 80500

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    checkUninitializedProperties: true

    exceptions:
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
            throwTypeCovariance: true
        implicitThrows: false
        checkedExceptionClasses:
            - Monadial\Nexus\Core\Exception\NexusException

    shipmonkRules:
        enforceReadonlyPublicProperty:
            enabled: true
        forbidCheckedExceptionInCallable:
            # TODO: Add allowedCheckedExceptionCallables for SupervisionStrategy once implemented (Task 5)
            allowedCheckedExceptionCallables: []
        forbidUnusedException:
            enabled: true
        forbidUselessNullableReturn:
            enabled: true

    paths:
        - packages/nexus-core/src
        - packages/nexus-runtime-fiber/src
        - packages/nexus-runtime-swoole/src
        - packages/nexus-serialization/src
