{
    "name": "nexus-actors/serialization-msgpack",
    "description": "Nexus msgpack serialization — dual-backend msgpack codec with native ext-msgpack and rybakit/msgpack fallback.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5.7",
        "cuyz/valinor": "^2.3",
        "nexus-actors/serialization": "dev-main",
        "rybakit/msgpack": "^0.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "ext-msgpack": "Native msgpack extension for faster packing"
    },
    "autoload": {
        "psr-4": {
            "Monadial\\Nexus\\Serialization\\Msgpack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Monadial\\Nexus\\Serialization\\Msgpack\\Tests\\": "tests/"
        }
    }
}
