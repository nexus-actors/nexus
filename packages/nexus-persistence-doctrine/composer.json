{
    "name": "nexus-actors/persistence-doctrine",
    "description": "Nexus persistence Doctrine ORM adapter — entity-based event store, snapshot store, and durable state store.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5.7",
        "nexus-actors/persistence": "^0.1",
        "nexus-actors/serialization": "^0.1",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.0",
        "symfony/uid": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Monadial\\Nexus\\Persistence\\Doctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Monadial\\Nexus\\Persistence\\Doctrine\\Tests\\": "tests/"
        }
    }
}
