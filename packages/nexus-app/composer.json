{
    "name": "nexus-actors/app",
    "description": "Nexus application bootstrap — convenience API for building actor systems.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5.7",
        "ext-pcntl": "*",
        "monolog/monolog": "^3.0",
        "nexus-actors/core": "^0.1",
        "nexus-actors/observability": "^0.1",
        "nexus-actors/runtime": "^0.1",
        "psr/log": "^3.0",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "nexus-actors/observability-otel": "^0.1",
        "nexus-actors/runtime-fiber": "^0.1",
        "open-telemetry/sdk": "^1.14",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Monadial\\Nexus\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Monadial\\Nexus\\App\\Tests\\": "tests/"
        }
    }
}
