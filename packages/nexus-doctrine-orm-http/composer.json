{
    "name": "nexus-actors/doctrine-orm-http",
    "description": "Nexus Doctrine ORM HTTP integration — per-request EntityManager scope middleware and transactional decorator.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5.7",
        "doctrine/orm": "^3.0",
        "nexus-actors/core": "^0.1",
        "nexus-actors/doctrine-dbal-http": "^0.1",
        "nexus-actors/doctrine-orm": "^0.1",
        "nexus-actors/http": "^0.1",
        "nyholm/psr7": "^1.8",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Monadial\\Nexus\\Doctrine\\Orm\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Monadial\\Nexus\\Doctrine\\Orm\\Http\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
