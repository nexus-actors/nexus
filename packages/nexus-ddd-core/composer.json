{
    "name": "nexus-actors/ddd-core",
    "description": "Nexus DDD Framework — tactical building blocks (Identity, Value, Entity, AggregateRoot, Specification, Policy).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "fp4php/functional": "^6.0",
        "psr/clock": "^1.0",
        "symfony/uid": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Monadial\\Nexus\\Ddd\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Monadial\\Nexus\\Ddd\\Core\\Tests\\": "tests/"
        }
    }
}
