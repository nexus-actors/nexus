# Copy to .env and edit as needed. The app service in docker-compose.yml loads
# this file automatically (env_file, required: false).
#
# The Nexus Skeleton installer appends the blocks relevant to your selections
# below. The commented entries here document every variable the generated
# bootstrap can read, with sane defaults.

# ── Persistence ──────────────────────────────────────────────────────────────
# Required when you selected an event-sourcing or durable-state persistence
# option. The db compose overlay provisions this Postgres instance.
# DATABASE_URL=postgres://nexus:nexus@db:5432/nexus

# ── TCP cluster mesh ─────────────────────────────────────────────────────────
# Read by the generated cluster bootstrap (Swoole runtime only).
# CLUSTER_NAME=my-cluster
# NODE_NAME=node-1
# CLUSTER_BIND=0.0.0.0:7361
# CLUSTER_ADVERTISE=127.0.0.1:7361
# Comma-separated host:port seeds; leave empty for a single-node cluster.
# CLUSTER_SEEDS=

# ── OpenTelemetry ────────────────────────────────────────────────────────────
# Read by ObservabilityConfig::fromEnv() when OpenTelemetry is enabled.
# OTEL_SERVICE_NAME=my-app
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# On Swoole, run OTLP export on a dedicated actor so a slow collector never
# blocks your actors.
# OTEL_NEXUS_ASYNC_EXPORT=1
