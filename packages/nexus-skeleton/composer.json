{
    "name": "nexus-actors/skeleton",
    "type": "project",
    "description": "Project skeleton for building applications on the Nexus actor system for PHP 8.5+.",
    "keywords": [
        "actor-system",
        "fibers",
        "nexus",
        "scaffold",
        "skeleton",
        "swoole"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.5.7",
        "nexus-actors/app": "^0.1",
        "nexus-actors/cluster-tcp": "^0.1",
        "nexus-actors/core": "^0.1",
        "nexus-actors/http": "^0.1",
        "nexus-actors/http-server-swoole": "^0.1",
        "nexus-actors/observability-otel": "^0.1",
        "nexus-actors/persistence": "^0.1",
        "nexus-actors/persistence-dbal": "^0.1",
        "nexus-actors/persistence-doctrine": "^0.1",
        "nexus-actors/runtime-fiber": "^0.1",
        "nexus-actors/runtime-step": "^0.1",
        "nexus-actors/runtime-swoole": "^0.1",
        "nexus-actors/worker-pool": "^0.1",
        "nexus-actors/worker-pool-swoole": "^0.1",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "nexus-actors/psalm": "^0.1",
        "phpunit/phpunit": "^13.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "NexusSkeleton\\Installer\\": "installer/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "NexusSkeleton\\Installer\\PostInstall::run"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
