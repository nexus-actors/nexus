{
    "name": "nexus-actors/symfony-demo",
    "description": "Production-pattern Nexus + Symfony demo on Swoole with Redis cache and Doctrine persistence.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-redis": "*",
        "ext-swoole": "*",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.0",
        "nexus-actors/core": "dev-main",
        "nexus-actors/runtime": "dev-main",
        "nexus-actors/runtime-swoole": "dev-main",
        "nexus-actors/symfony": "dev-main",
        "nexus-actors/symfony-worker-pool": "dev-main",
        "symfony/cache": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/uid": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpro/grumphp": "^2.19",
        "phpunit/phpunit": "^13.0",
        "slevomat/coding-standard": "^8.0",
        "squizlabs/php_codesniffer": "^4.0",
        "swoole/ide-helper": "^6.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {"type": "path", "url": "../../packages/nexus-core"},
        {"type": "path", "url": "../../packages/nexus-runtime"},
        {"type": "path", "url": "../../packages/nexus-runtime-swoole"},
        {"type": "path", "url": "../../packages/nexus-app"},
        {"type": "path", "url": "../../packages/nexus-serialization"},
        {"type": "path", "url": "../../packages/nexus-symfony"},
        {"type": "path", "url": "../../packages/nexus-symfony-worker-pool"},
        {"type": "path", "url": "../../packages/nexus-worker-pool"},
        {"type": "path", "url": "../../packages/nexus-worker-pool-swoole"}
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
