<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Monadial\Nexus\Psalm\Plugin" />
    </plugins>

    <issueHandlers>
        <PluginIssue name="UntypedActorRefInjection">
            <errorLevel type="suppress">
                <!-- ContextBus is intentionally heterogeneous: every bounded context publishes
                     different event types through the same bus — per-event-type generics would
                     collapse the fan-out seam to a single type, defeating the design. -->
                <file name="src/Platform/Bus/Subscribe.php"/>
                <!-- OrderRefFactory caches refs to actors that accept a union of command types
                     (PlaceOrder | CancelOrder). PHP cannot express this as a single generic
                     type parameter, so ActorRef<object> is the necessary approximation. -->
                <file name="src/Orders/Application/OrderRefFactory.php"/>
                <!-- InventoryRefFactory caches refs to actors that accept a union of command types
                     (Restock | ReserveStock | ReleaseReservation). Same reason as OrderRefFactory. -->
                <file name="src/Inventory/Application/InventoryRefFactory.php"/>
                <!-- ProcessRefFactory caches refs to saga actors that accept a union of bus-delivered
                     events (OrderPlaced | StockReserved | StockReservationRejected). Same reason. -->
                <file name="src/Fulfillment/Application/ProcessRefFactory.php"/>
            </errorLevel>
        </PluginIssue>
    </issueHandlers>
</psalm>
