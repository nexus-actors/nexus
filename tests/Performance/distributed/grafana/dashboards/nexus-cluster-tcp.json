{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "timezone": "browser",
  "title": "Nexus Cluster TCP — Traces & Metrics",
  "uid": "nexus-cluster-tcp",
  "tags": ["nexus", "cluster-tcp"],
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "constant",
        "query": "nexus-cluster-mesh",
        "current": { "text": "nexus-cluster-mesh", "value": "nexus-cluster-mesh" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Cluster tracing",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "traces",
      "title": "Recent cluster traces (Tempo)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"nexus-cluster-mesh\" }",
          "tableType": "traces",
          "limit": 50
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Span rate by operation  (spans/s)",
      "description": "cluster.send / cluster.ask / cluster.handshake span throughput, from Tempo's span-metrics.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service_name=\"nexus-cluster-mesh\"}[1m]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Span latency p95 by operation",
      "description": "95th-percentile span duration from Tempo's span-metrics latency histogram.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (span_name, le) (rate(traces_spanmetrics_latency_bucket{service_name=\"nexus-cluster-mesh\"}[1m])))",
          "legendFormat": "p95 {{span_name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Message throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 }
    },
    {
      "type": "stat",
      "title": "Cluster tells/s (all nodes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate({__name__=~\"nexus_cluster_messages_sent.*\"}[1m]))",
          "legendFormat": "tells/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Remote tells/s by node",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 20 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } }, "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node_id) (rate({__name__=~\"nexus_cluster_messages_sent.*\"}[1m]))",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bytes sent/s (all nodes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate({__name__=~\"nexus_cluster_bytes_sent.*_sum\"}[1m]))",
          "legendFormat": "bytes/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Local short-circuit tells/s",
      "description": "Sends resolved in-process (no frame / no serialization).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate({__name__=~\"nexus_cluster_messages_local_shortcircuit.*\"}[1m]))",
          "legendFormat": "local/s"
        }
      ]
    },
    {
      "type": "row",
      "title": "Ask (request/response) & membership health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },
    {
      "type": "timeseries",
      "title": "Ask round-trip latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=~\"nexus_cluster_ask_duration.*_bucket\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"nexus_cluster_ask_duration.*_bucket\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=~\"nexus_cluster_ask_duration.*_bucket\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Asks: pending / resolved / timed-out / rejected",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum({__name__=~\"nexus_cluster_asks_pending.*\"})",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate({__name__=~\"nexus_cluster_asks_resolved.*\"}[1m]))",
          "legendFormat": "resolved/s"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate({__name__=~\"nexus_cluster_asks_timed_out.*\"}[1m]))",
          "legendFormat": "timed-out/s"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate({__name__=~\"nexus_cluster_asks_capacity_rejected.*\"}[1m]))",
          "legendFormat": "rejected/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Handshakes rejected/s  (auth / cross-cluster / protocol)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 41 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate({__name__=~\"nexus_cluster_handshake_rejected.*\"}[1m]))",
          "legendFormat": "rejected/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Frames sent/s by node",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 41 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node_id) (rate({__name__=~\"nexus_cluster_frames_sent.*\"}[1m]))",
          "legendFormat": "{{node_id}}"
        }
      ]
    }
  ]
}
