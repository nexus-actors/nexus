{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "timezone": "browser",
  "title": "Nexus — Cluster Overview (all subsystems)",
  "uid": "nexus-overview",
  "tags": ["nexus", "overview"],
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    { "type": "row", "title": "At a glance", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "stat", "title": "Nodes running", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum({__name__=~\"nexus_actor_system_running.*\"})", "legendFormat": "running" }]
    },
    {
      "type": "stat", "title": "Live actors", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum({__name__=~\"nexus_actor_system_live_actors.*\"})", "legendFormat": "actors" }]
    },
    {
      "type": "stat", "title": "Cluster tells/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 }, "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_cluster_messages_sent.*\"}[1m]))", "legendFormat": "tells/s" }]
    },
    {
      "type": "stat", "title": "Ask p95", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 }, "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"nexus_cluster_ask_duration.*_bucket\"}[1m])))", "legendFormat": "p95" }]
    },
    {
      "type": "stat", "title": "Dead letters/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 }, "fieldConfig": { "defaults": { "unit": "ops", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_actor_system_dead_letters.*\"}[1m]))", "legendFormat": "dead/s" }]
    },
    {
      "type": "stat", "title": "Handshake rejects/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 }, "fieldConfig": { "defaults": { "unit": "ops", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_cluster_handshake_rejected.*\"}[1m]))", "legendFormat": "rejects/s" }]
    },

    { "type": "row", "title": "Actor system", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "type": "timeseries", "title": "Live actors by node", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (node_id) ({__name__=~\"nexus_actor_system_live_actors.*\"})", "legendFormat": "{{node_id}}" }]
    },
    {
      "type": "timeseries", "title": "Dead letters/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_actor_system_dead_letters.*\"}[1m]))", "legendFormat": "dead/s" }]
    },

    { "type": "row", "title": "Cluster TCP — messaging", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },
    {
      "type": "timeseries", "title": "Remote tells/s + local short-circuit/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_cluster_messages_sent.*\"}[1m]))", "legendFormat": "remote/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_cluster_messages_local_shortcircuit.*\"}[1m]))", "legendFormat": "local/s" }
      ]
    },
    {
      "type": "timeseries", "title": "Bytes sent/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 14 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "Bps" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_cluster_bytes_sent.*_sum\"}[1m]))", "legendFormat": "bytes/s" }]
    },
    {
      "type": "timeseries", "title": "Frames sent/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_cluster_frames_sent.*\"}[1m]))", "legendFormat": "frames/s" }]
    },

    { "type": "row", "title": "Cluster TCP — ask & membership", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 } },
    {
      "type": "timeseries", "title": "Ask latency p50/p95/p99", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=~\"nexus_cluster_ask_duration.*_bucket\"}[1m])))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"nexus_cluster_ask_duration.*_bucket\"}[1m])))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=~\"nexus_cluster_ask_duration.*_bucket\"}[1m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries", "title": "Asks pending / resolved / timed-out / rejected", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum({__name__=~\"nexus_cluster_asks_pending.*\"})", "legendFormat": "pending" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_cluster_asks_resolved.*\"}[1m]))", "legendFormat": "resolved/s" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_cluster_asks_timed_out.*\"}[1m]))", "legendFormat": "timed-out/s" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_cluster_asks_capacity_rejected.*\"}[1m]))", "legendFormat": "rejected/s" }
      ]
    },

    { "type": "row", "title": "Serialization  (needs TracingMessageSerializer)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 } },
    {
      "type": "timeseries", "title": "Operations/s by serializer", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 30 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (nexus_serializer) (rate({__name__=~\"nexus_serialization_operations.*\"}[1m]))", "legendFormat": "{{nexus_serializer}}" }]
    },
    {
      "type": "timeseries", "title": "Serialize duration p95", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 30 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ms" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"nexus_serialization_duration.*_bucket\"}[1m])))", "legendFormat": "p95" }]
    },
    {
      "type": "timeseries", "title": "Serialization failures/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 30 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_serialization_failures.*\"}[1m]))", "legendFormat": "failures/s" }]
    },

    { "type": "row", "title": "Runtime / Swoole  ·  Persistence  ·  Worker pool  (when those subsystems run with observability)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 } },
    {
      "type": "timeseries", "title": "Swoole coroutines (count / peak)", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 38 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum({__name__=~\"swoole_coroutine_count.*\"})", "legendFormat": "count" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max({__name__=~\"swoole_coroutine_peak.*\"})", "legendFormat": "peak" }
      ]
    },
    {
      "type": "timeseries", "title": "Persistence: events persisted/s · snapshots/s", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 38 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_persistence_events_persisted.*\"}[1m]))", "legendFormat": "events/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_persistence_snapshots_saved.*\"}[1m]))", "legendFormat": "snapshots/s" }
      ]
    },
    {
      "type": "timeseries", "title": "Worker pool: messages sent/s · send p95", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 38 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate({__name__=~\"nexus_worker_pool_messages_sent.*\"}[1m]))", "legendFormat": "sent/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"nexus_worker_pool_send_duration.*_bucket\"}[1m])))", "legendFormat": "send p95 (ms)" }
      ]
    },

    { "type": "row", "title": "Distributed tracing", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 } },
    {
      "type": "timeseries", "title": "Span rate by operation", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 46 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total[1m]))", "legendFormat": "{{span_name}}" }]
    },
    {
      "type": "timeseries", "title": "Span latency p95 by operation", "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 46 }, "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (span_name, le) (rate(traces_spanmetrics_latency_bucket[1m])))", "legendFormat": "{{span_name}}" }]
    },
    {
      "type": "traces", "title": "Recent traces (Tempo)", "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 46 },
      "targets": [{ "refId": "A", "datasource": { "type": "tempo", "uid": "tempo" }, "queryType": "traceql", "query": "{ resource.service.name = \"nexus-cluster-mesh\" }", "tableType": "traces", "limit": 30 }]
    }
  ]
}
