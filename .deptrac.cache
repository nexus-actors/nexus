cp\/src\/Loopback\/LoopbackMeshTransport.php\";s:4:\"line\";i:10;}s:14:\"dependencyType\";r:138;}}i:4;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:8:\"Override\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackMeshTransport.php\";s:4:\"line\";i:11;}s:14:\"dependencyType\";r:138;}}i:5;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:16:\"RuntimeException\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackMeshTransport.php\";s:4:\"line\";i:12;}s:14:\"dependencyType\";r:138;}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackPeerLink.php":{"hash":"97d56148e2e36dbbacd0b78713cec37aed316e28","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:601:\"\n\nOne end of an in-process loopback link. Two LoopbackPeerLink instances are\ncreated per connection (client end + server end) and wired together via\nlinkPeer(). Frame delivery is asynchronous: sendFrame() spawns a short-lived\nruntime task so delivery happens on the next event-loop tick rather than\ninline, matching the semantics of a real TCP socket.\n\nreceiveFrame() and receiveClose() are public so that the spawned closures\n(which are static and thus have no $this context) can invoke them on the\npeer object. They are not part of the PeerLink contract and should not be\ncalled by application code.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:52:\"Monadial\\Nexus\\Cluster\\Tcp\\Loopback\\LoopbackPeerLink\";}s:8:\"inherits\";a:1:{i:0;O:46:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\":4:{s:13:\"classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:35:\"Monadial\\Nexus\\Cluster\\Tcp\\PeerLink\";}s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:65:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackPeerLink.php\";s:4:\"line\";i:28;}s:4:\"type\";E:61:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInheritType:IMPLEMENTS\";s:52:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\u0000path\";a:0:{}}}s:12:\"dependencies\";a:11:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:32:\"Monadial\\Nexus\\Cluster\\Tcp\\Frame\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:65:\"\/app\/packages\/nex