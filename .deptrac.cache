rnTypeProvider.php\";s:4:\"line\";i:16;}s:14:\"dependencyType\";r:234;}}i:10;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:16:\"Psalm\\Type\\Union\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:71:\"\/app\/packages\/nexus-psalm\/src\/Hook\/EntityBehaviorReturnTypeProvider.php\";s:4:\"line\";i:17;}s:14:\"dependencyType\";r:234;}}}}"},"\/app\/packages\/nexus-psalm\/src\/Hook\/MismatchedReplyTypeRule.php":{"hash":"bded108bee4f78ecace0fb21786493e826173b45","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:1020:\"\n\nFlags `ActorContext::reply($x)` calls where the message currently being\nhandled has a `#[ReplyType(Expected::class)]` attribute but `$x` is not\nan instance of `Expected`.\n\nFinding the \"current message\":\n\n  At a reply() call site, this hook walks vars_in_scope looking for\n  variables whose narrowed type is a single concrete class carrying\n  `#[ReplyType]`. If EXACTLY ONE such variable is in scope, it's\n  treated as the active message and the rule fires. If zero or more\n  than one qualify, the rule silently skips \u2014 we'd rather miss a real\n  mismatch than false-positive on legitimate code.\n\nWorks with the canonical `match (true) { $msg instanceof X => ... }`\npattern AND the typed-parameter pattern (`function (ActorContext $ctx,\nGetOrder $msg)`).\n\nDoes NOT flag if the reply value is itself a union that INCLUDES the\nexpected type \u2014 e.g. `$ctx->reply($maybeOrder)` where `$maybeOrder` is\n`Order|null` is allowed (Psalm's normal type-checker will catch the\nnull case if reply()'s signature requires non-null).\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:49:\"Monadial\\Nexus\\Psalm\\Hook\\MismatchedReplyTypeRule\";}s:8:\"inherits\";a:1:{i:0;O:46:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\":4:{s:13:\"classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:58:\"Psalm\\Plugin\\EventHandler\\AfterMethodCallAnalysisInterface\";}s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:62:\"\/app\/packages\/nexus-psalm\/src\/Hook\/MismatchedReplyTypeRule.php\";s:4:\"line\";i:50;}s:4:\"type\";E:61:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInheritType:IMPLEMENTS\";s:52:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\u0000path\";a:0:{}}}s:12:\"dependencies\";a:29:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FunctionToken\":1:{s:12:\"functionName\";s:10:\"strtolower\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:62:\"\/app\/packages\/nexus-psalm\/src\/Hook\/MismatchedReplyTypeRule.php\";s:4:\"line\";i:57;}s:14:\"dependencyType\";E:75:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:UNRESOLVED_FUNCTION_CALL\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\