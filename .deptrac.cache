currence\":2:{s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackMeshTransport.php\";s:4:\"line\";i:49;}s:14:\"dependencyType\";E:62:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:RETURN_TYPE\";}}i:10;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:8:\"Override\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackMeshTransport.php\";s:4:\"line\";i:80;}s:14:\"dependencyType\";r:83;}}i:11;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:39:\"Monadial\\Nexus\\Cluster\\Tcp\\NodeEndpoint\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackMeshTransport.php\";s:4:\"line\";i:81;}s:14:\"dependencyType\";r:35;}}i:12;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:8:\"Override\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackMeshTransport.php\";s:4:\"line\";i:87;}s:14:\"dependencyType\";r:83;}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:1119:\"\n\nPure-PHP in-process mesh transport backed by a shared LoopbackHub.\n\nThis is the Fiber dev\/test transport for nexus-cluster-tcp \u2014 it requires no\next-swoole and no real network sockets. It is shipped in src\/ (not test support)\nbecause application code uses it in local development and integration tests.\n\nHub design: a single LoopbackHub is shared across all transport instances that\nform a loopback cluster. This is necessary because each transport only knows\nabout its own listeners; the hub is the rendezvous point.\n\n  $hub  = new LoopbackHub();\n  $nodeA = new LoopbackMeshTransport($hub, $runtime);   \/\/ serves on port 7001\n  $nodeB = new LoopbackMeshTransport($hub, $runtime);   \/\/ connects to port 7001\n\nAsync delivery: connect() spawns a runtime task for the onAccept callback;\nPeerLink.sendFrame() spawns a task per frame. Both use Runtime::spawn() so\nthey run cooperatively on the next event-loop tick \u2014 identical semantics to\na real TCP peer connection.\n\nconnect() to an unserved endpoint throws RuntimeException immediately (fail-fast:\nin loopback mode, connecting before serve() is a programming error).\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackMeshTransport.php\";s:12:\"dependencies\";a:6:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:40:\"Monadial\\Nexus\\Cluster\\Tcp\\MeshTransport\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\