Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:81:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/TcpMembershipEffectInterpreter.php\";s:4:\"line\";i:98;}s:14:\"dependencyType\";E:56:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:CATCH\";}}i:18;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:43:\"Monadial\\Nexus\\Observability\\Metric\\Counter\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:81:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/TcpMembershipEffectInterpreter.php\";s:4:\"line\";i:103;}s:14:\"dependencyType\";E:62:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:RETURN_TYPE\";}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:1019:\"\n\nExecutes the outbound effects produced by membership transitions over TCP.\n\nFor HandshakeResponse: sends the HandshakeAck. The peer's identity is established by the\nself-Handshake that {@see \\Monadial\\Nexus\\Cluster\\Tcp\\ClusterNode} sends as the\n{@see \\Monadial\\Nexus\\Cluster\\Tcp\\PeerConnection} preamble on every (re)connect, so this\ninterpreter no longer sends a Handshake itself \u2014 that made identity a once-per-process fact\nand left reconnected\/restarted peers unidentifiable. Sending only the ack here keeps the\nexchange from looping (an ack never triggers another handshake).\n\nFor SendGossip: serialises the GossipPayload once and sends to each Up peer\nvia the shared sender closure. Targets that have no registered endpoint are\nsilently skipped (the membership layer will retry on the next gossip tick).\n\nThe $sender closure routes frames through ClusterNode's shared connection\ninfrastructure: accepted inbound links are preferred; a new outbound\nPeerConnection is created lazily when no accepted link exists.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:81:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/TcpMembershipEffectInterpreter.php\";s:12:\"dependencies\";a:10:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:7:\"Closure\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:81:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/TcpMembershipEffectInterpreter.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:32:\"Monadial\\Nexus\\Cluster\\Tcp\\Frame\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:81:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/TcpMembershipEffectInterpreter.php\";s:4:\"line\";i:8;}s:14:\"dependencyType\";r:186;}}i:2;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:36:\"Monadial\\Nexus\\Cluster\\Tcp\\FrameType\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contr