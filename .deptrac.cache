salm-api\";a:1:{i:0;s:408:\"\n\nImmutable configuration value object for a cluster node. Carries all knobs\nneeded to bootstrap ClusterNode: identity, network endpoints, seed list,\ntiming parameters, and optional TLS.\n\nBind vs. advertise: `bindEndpoint` is the local address the TCP server binds\nto (e.g. `0.0.0.0:7355`); `advertiseEndpoint` is what peers use to connect\n(e.g. the pod IP in Kubernetes). They may be the same on bare-metal.\";}s:8:\"@example\";a:1:{i:0;s:355:\"\n$topology = ClusterTopology::create(\n    clusterName: 'production',\n    self: new NodeAddress('prod', 'eu', 'payments', 'node-1'),\n    bindEndpoint: new NodeEndpoint(Host::of('0.0.0.0'), Port::of(7355)),\n    advertiseEndpoint: new NodeEndpoint(Host::of('10.0.0.1'), Port::of(7355)),\n    seeds: [new NodeEndpoint(Host::of('10.0.0.2'), Port::of(7355))],\n);\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:42:\"Monadial\\Nexus\\Cluster\\Tcp\\ClusterTopology\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:65:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:39:\"Monadial\\Nexus\\Cluster\\Tcp\\NodeEndpoint\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:55:\"\/app\/packages\/nexus-cluster-tcp\/src\/ClusterTopology.php\";s:4:\"line\";i:38;}s:14:\"dependencyType\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:PARAMETER\";}}i:1;O:51:\"Deptrac\\Deptra