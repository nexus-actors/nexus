2014 so they deliberately do NOT\ngo through the generic Valinor-backed serializer, whose reflection-driven object mapping is pure\noverhead for a small, fixed, internally-owned set of VOs. (Valinor remains the right tool for\narbitrary USER message bodies, which flow through {@see \\Monadial\\Nexus\\Cluster\\Tcp\\Messaging\\ClusterMessageCodec}.)\n\nEach frame is a msgpack map keyed by property name, so the bytes are identical to the previous\nValinor encoding and readers resolve fields by key with defaults \u2014 nodes on either encoder interop,\nand a newer protocol version can add a field without breaking an older decoder.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:65:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/ControlFrameCodec.php\";s:12:\"dependencies\";a:1:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:49:\"Monadial\\Nexus\\Serialization\\Msgpack\\MsgpackCodec\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:65:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/ControlFrameCodec.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/GossipPayload.php":{"hash":"17364c115eea47b251f33694cae467e0280af2f8","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:2:{s:10:\"@psalm-api\";a:1:{i:0;s:580:\"\n\nPeriodic gossip message exchanged between peers to converge cluster view.\n`members` carries full membership state for every known node (Up and Suspect)\nso that gossip propagates incarnation numbers and non-Up status, enabling the\nreceiver to merge accurately even without a direct connection.\n`registrations` is reserved for C2 (service discovery); always empty in C1.\n\nWire encoding: each member is a plain scalar map so msgpack\/Valinor can\nround-trip the payload without custom normalizers.\n\n`status` integers correspond to MemberStatus::rank(): Up = 1, Suspect = 2, Down = 3.\";}s:11:\"@psalm-type\";a:2:{i:0;s:84:\"GossipMember array{address: string, endpoint: string, incarnation: int, status: int}\";i:1;s:37:\"RegistrationMap array<string, string>\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:48:\"Monadial\\Nexus\\Cluster\\Tcp\\Payload\\GossipPayload\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:2:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:47:\"Monadial\\Nexus\\Cluster\\Tcp\\Payload\\GossipMember\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:61:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/GossipPayload.php\";s:4:\"line\";i:35;}s:14:\"dependencyType\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:PARAMETER\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:40:\"Monadial\\Nexus\\Serialization\\MessageType\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:61:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/GossipPayload.php\";s:4:\"line\";i:26;}s:14:\"dependencyType\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:ATTRIBUTE\";}}}s:4:\"tags\";a:2:{s:10:\"@psalm-api\";a:1:{i:0;s:580:\"\n\nPeriodic gossip message exchanged between peers to converge cluster view.\n`members` carries full membership state for every known node (Up and Suspect)\nso that gossip propagates incarnation numbers and non-Up status, enabling the\nreceiver to merge accurately even without a direct connection.\n`registrations` is reserved for C2 (service discovery); always empty in C1.\n\nWire encoding: each member is a plain scalar map so msgpack\/Valinor can\nround-trip the payload without custom normalizers.\n\n`status` integers correspond to MemberStatus::rank(): Up = 1, Suspect = 2, Down = 3.\";}s:11:\"@psalm-type\";a:2:{i:0;s:84:\"GossipMember array{address: string, endpoint: string, incarnation: int, status: int}\";i:1;s:37:\"RegistrationMap array<string, string>\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:61:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/GossipPayload.php\";s:12:\"dependencies\";a:1:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:40:\"Monadial\\Nexus\\Serialization\\MessageType\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:61:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/GossipPayload.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/Handshake.php":{"hash":"7f054c85e70699880800bec11a9ff7ff3b3cce36","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:2:{s:10:\"@psalm-api\";a:1:{i:0;s:577:\"\n\nSent by the connecting node immediately after TCP connection to identify\nitself and assert cluster membership. The `node` map carries the four\nNodeAddress fields (cluster\/datacenter\/application\/node) as plain strings.\n`advertise` is the host:port peers should use to connect back.\n\nWhen a cluster secret is configured, `nonce`\/`issuedAt`\/`mac` carry the\n{@see \\Monadial\\Nexus\\Cluster\\Tcp\\Membership\\HandshakeAuthenticator} signature\nproving the sender holds the secret; they are null on an unauthenticated cluster\n(and remain wire-compatible with peers that never send them).\";}s:11:\"@psalm-type\";a:1:{i:0;s:29:\"NodeMap array<string, string>\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:44:\"Monadial\\Nexus\\Cluster\\Tcp\\Payload\\Handshake\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:2:{i:0;O:51:\"Deptrac\\Deptrac\\