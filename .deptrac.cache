c\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:68:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/MembershipService.php\";s:4:\"line\";i:12;}s:14:\"dependencyType\";r:1274;}}i:6;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:31:\"Monadial\\Nexus\\Runtime\\Duration\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:68:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/MembershipService.php\";s:4:\"line\";i:13;}s:14:\"dependencyType\";r:1274;}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/PhiAccrualDetector.php":{"hash":"b6b040497902493a4e1783ab4723c2bc560286b5","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:807:\"\n\nHayashibara phi-accrual failure detector. Tracks a per-peer sliding window of\nheartbeat inter-arrival intervals (in milliseconds) and, on demand, reports a\ncontinuous suspicion level `phi = -log10(P(elapsed))` where `P` is the tail\nprobability of the elapsed time under a normal distribution fitted to the\nwindow. A higher phi means the peer is more likely dead; callers compare it to\na threshold (default 8.0).\n\nThe normal tail is computed directly (Abramowitz & Stegun 26.2.17) rather than\nas `1 - CDF`, avoiding catastrophic cancellation deep in the tail so phi keeps\nclimbing past the threshold instead of saturating.\n\nA standard-deviation floor (`minStdDev`, default 500 ms) keeps phi bounded when\narrivals are near-perfectly periodic (otherwise stddev \u2192 0 and phi explodes on\nthe first late beat).\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:56:\"Monadial\\Nexus\\Cluster\\Tcp\\Membership\\PhiAccrualDetector\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:16:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:24:\"InvalidArgumentException\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:69:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/PhiAccrualDetector.php\";s:4:\"line\";i:61;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:NEW\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:24:\"InvalidArgumentException\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:69:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/PhiAccrualDetector.php\";s:4:\"line\";i:65;}s:14:\"dependencyType\";r:19;}}i:2;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\Depende