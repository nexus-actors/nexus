ndencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:66:\"\/app\/packages\/nexus-cluster-tcp\/src\/Swoole\/SwooleMeshTransport.php\";s:4:\"line\";i:19;}s:14:\"dependencyType\";r:278;}}i:13;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:9:\"Throwable\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:66:\"\/app\/packages\/nexus-cluster-tcp\/src\/Swoole\/SwooleMeshTransport.php\";s:4:\"line\";i:20;}s:14:\"dependencyType\";r:278;}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Swoole\/SwoolePeerLink.php":{"hash":"813352903888c0243ab942b84a377f1aa2e0e6c2","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:1009:\"\n\nSwoole coroutine-backed PeerLink. One instance wraps a single TCP socket\n(either the server side accepted from `Swoole\\Coroutine\\Server` or the\nclient side created by `Swoole\\Coroutine\\Client`). Frames are length-prefixed\non the wire using `FrameCodec`; the receive loop accumulates partial reads\nin a buffer and emits frames as they complete.\n\nReceive loop: started in the constructor via `Runtime::spawn()`. Reads raw\nbytes from the socket, feeds them to `FrameCodec::decodeStream()`, and\ndispatches complete frames to registered `onFrame` handlers. The loop exits\nwhen the socket is closed by either end.\n\nClient lifetime: `Swoole\\Coroutine\\Client` has a `__destruct` that closes\nthe underlying socket. For client-side links, the Client must be kept alive\nas long as the PeerLink is alive \u2014 pass it as `$clientOwner` so PHP's\nreference counting keeps it alive.\n\nThread-safety: not required \u2014 Swoole coroutines are cooperative and all\naccess to this object happens within the same coroutine scheduler.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:48:\"Monadial\\Nexus\\Cluster\\Tcp\\Swoole\\SwoolePeerLink\";}s:8:\"inherits\";a:1:{i:0;O:46:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\":4:{s:13:\"classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:35:\"Monadial\\Nexus\\Cluster\\Tcp\\PeerLink\";}s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:61:\"\/app\/packages\/nexus-cluster-tcp\/src\/Swoole\/SwoolePeerLink.php\";s:4:\"line\";i:42;}s:4:\"type\";E:61:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInheritType:IMPLEMENTS\";s:52:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\u0000path\";a:0:{}}}s:12:\"dependencies\";a:25:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:32:\"Monadial\\Nexus\\Cluster\\Tcp\\Frame\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:61:\"\/app\/packages\/nexus-cluster-tcp\/src\/Sw