yType\";r:51;}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:696:\"\n\nShared in-process registry that maps endpoint strings to their active\nserve() listeners. Multiple LoopbackMeshTransport instances share one hub\nso that node A can connect() to node B's serve() listener.\n\nThe hub is the single object that crosses transport boundaries. Inject one\ninstance into every transport that forms a loopback cluster:\n\n  $hub  = new LoopbackHub();\n  $nodeA = new LoopbackMeshTransport($hub, $runtime);\n  $nodeB = new LoopbackMeshTransport($hub, $runtime);\n\nDesign note: per-transport-instance state cannot work for multi-node\nloopback because each transport only knows about its own listeners; the hub\nis the rendezvous point that makes cross-transport connect() possible.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:60:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackHub.php\";s:12:\"dependencies\";a:3:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:7:\"Closure\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:60:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackHub.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:39:\"Monadial\\Nexus\\Cluster\\Tcp\\NodeEndpoint\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:60:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackHub.php\";s:4:\"line\";i:8;}s:14:\"dependencyType\";r:82;}}i:2;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:35:\"Monadial\\Nexus\\Cluster\\Tcp\\PeerLink\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:60:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackHub.php\";s:4:\"line\";i:9;}s:14:\"dependencyType\";r:82;}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackMeshTransport.php":{"hash":"c9356e14dda7935faa991b1daf62ba84320ff831","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:1119:\"\n\nPure-PHP in-process mesh transport backed by a shared LoopbackHub.\n\nThis is the Fiber dev\/test transport for nexus-cluster-tcp \u2014 it requires no\next-swoole and no real network sockets. It is shipped in src\/ (not test support)\nbecause application code uses it in local development and integration tests.\n\nHub design: a single LoopbackHub is shared across all transport instances that\nform a loopback cluster. This is necessary because each transport only knows\nabout its own listeners; the hub is the rendezvous point.\n\n  $hub  = new LoopbackHub();\n  $nodeA = new LoopbackMeshTransport($hub, $runtime);   \/\/ serves on port 7001\n  $nodeB = new LoopbackMeshTransport($hub, $runtime);   \/\/ connects to port 7001\n\nAsync delivery: connect() spawns a runtime task for the onAccept callback;\nPeerLink.sendFrame() spawns a task per frame. Both use Runtime::spawn() so\nthey run cooperatively on the next event-loop tick \u2014 identical semantics to\na real TCP peer connection.\n\nconnect() to an unserved endpoint throws RuntimeException immediately (fail-fast:\nin loopback mode, connecting before serve() is a programming error).\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:57:\"Monadial\\Nexus\\Cluster\\Tcp\\Loopback\\LoopbackMeshTransport\";}s:8:\"inherits\";a:1:{i:0;O:46:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\":4:{s:13:\"classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:40:\"Monadial\\Nexus\\Cluster\\Tcp\\MeshTransport\";}s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackMeshTransport.php\";s:4:\"line\";i:41;}s:4:\"type\";E:61:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInheritType:IMPLEMENTS\";s:52:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\u0000path\";a:0:{}}}s:12:\"dependencies\";a:13:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:39:\"Monadial\\Nexus\\Cluster\\Tcp\\NodeEndpoint\";}s:7:\"context\";O:53:\"Deptrac\\D