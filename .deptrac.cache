:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:90:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/EventDispatcherMembershipEventPublisher.php\";s:4:\"line\";i:22;}s:14:\"dependencyType\";r:27;}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:231:\"\n\nPublishes MembershipEvents to the ActorSystem's PSR-14 EventDispatcher.\nKept thin: the event object is dispatched as-is. C1.7 will add metrics and\ntrace annotations on a separate layer; this class stays a pure dispatch forwarder.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:90:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/EventDispatcherMembershipEventPublisher.php\";s:12:\"dependencies\";a:2:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:8:\"Override\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:90:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/EventDispatcherMembershipEventPublisher.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:44:\"Psr\\EventDispatcher\\EventDispatcherInterface\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:90:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/EventDispatcherMembershipEventPublisher.php\";s:4:\"line\";i:8;}s:14:\"dependencyType\";r:58;}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/HandshakeAuthenticator.php":{"hash":"e001b72c9e98f36b3bf1dd1542dc35f3497d1de2","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:2110:\"\n\nAuthenticates cluster handshakes with a shared-secret HMAC.\n\nWithout this, `clusterName` is only a label: any process that can reach the bind\nport and speak the framing completes a handshake and joins. When a cluster secret\nis configured, a joining node must prove it holds the secret by signing its\nhandshake; a peer that cannot produce a valid signature is rejected before any\ningress is wired, so it can neither join the membership view nor deliver messages.\n\nThis is cluster-membership authentication (holding the secret \u21d2 you are a member),\nthe same model as Serf\/Consul gossip keys \u2014 not per-node identity binding, which\nTLS client-certificate verification provides at the transport layer and is the\nrecommended complement. A compromised member leaks the shared secret; rotate it and\nfence the network accordingly.\n\nSignature covers the full identity claim (cluster name, protocol version, node\naddress, advertise endpoint) plus a per-handshake nonce and issue timestamp. The\ntimestamp is checked against `freshnessWindow` (default 60 s) so a captured handshake\nexpires once outside that window; comparison is constant-time. Within the window a\nbounded, time-evicted seen-nonce set rejects an exact replay of a handshake this\nverifier has already accepted \u2014 so a captured frame cannot be replayed *to the same node*\nwhile it is still fresh. The seen-nonce set is per-node, so this does NOT stop a captured\nhandshake from being replayed to a *different* node within the freshness window; cross-node\nreplay is mitigated only by TLS (`withTls(verifyPeer: true)`), which prevents on-path capture\nin the first place. The nonce set is evicted lazily on every {@see verify()} call, dropping\nentries whose issue timestamp has aged past the freshness window, which bounds memory\nto at most one entry per distinct handshake seen within the last `freshnessWindow`.\n\nThread-confinement: this object is owned by the recv path \/ membership actor of a\nsingle node and is never shared across Swoole threads, so the mutable nonce set needs\nno locking \u2014 matching the rest of the package's confinement convention.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:60:\"Monadial\\Nexus\\Cluster\\Tcp\\Membership\\HandshakeAuthenticator\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:20:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:24:\"Psr\\Clock\\ClockInterface\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:73:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/HandshakeAuthenticator.php\";s:4:\"line\";i:60;}s:14:\"dependencyType\";E:59:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:VARIABLE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Dep