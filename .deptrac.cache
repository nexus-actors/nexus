ence\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:222:\"\n\nResponse to a Handshake frame. When `accepted` is false, `reason` explains\nthe rejection (e.g. cluster name mismatch). `view` is a snapshot of the\nacceptor's current cluster view: node path-prefix \u2192 advertise endpoint.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:47:\"Monadial\\Nexus\\Cluster\\Tcp\\Payload\\HandshakeAck\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:1:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:40:\"Monadial\\Nexus\\Serialization\\MessageType\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:60:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/HandshakeAck.php\";s:4:\"line\";i:16;}s:14:\"dependencyType\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:ATTRIBUTE\";}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:222:\"\n\nResponse to a Handshake frame. When `accepted` is false, `reason` explains\nthe rejection (e.g. cluster name mismatch). `view` is a snapshot of the\nacceptor's current cluster view: node path-prefix \u2192 advertise endpoint.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:60:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/HandshakeAck.php\";s:12:\"dependencies\";a:1:{i:0;O:51:\"Deptrac\\Deptrac