ontext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:51:\"\/app\/packages\/nexus-cluster-tcp\/src\/ClusterNode.php\";s:4:\"line\";i:1422;}s:14:\"dependencyType\";r:549;}}}s:4:\"tags\";a:2:{s:10:\"@psalm-api\";a:1:{i:0;s:1372:\"\n\nThe cluster node bootstrap: wires every mesh component into a running cluster node.\n\nBoot the node after creating the ActorSystem but before calling `$system->run()`. The\nnode's membership actor schedules its own heartbeat \/ gossip ticks, so once the runtime\nloop starts everything is self-driving.\n\nTransport selection: SwooleMeshTransport when ext-swoole is loaded AND the system runtime\nis SwooleRuntime; LoopbackMeshTransport with a fresh hub otherwise. Pass an explicit\n`$transport` to override \u2014 this is the hook for multi-node loopback integration tests.\n\nCircular boot dependency is resolved with a lazy sender: the `TcpMembershipEffectInterpreter`\nreceives a closure that captures `$selfNode` by reference. `$selfNode` is null during the\nassembly phase but is set before `$system->run()` fires any actor messages, so the closure\nalways finds a populated node when actually called.\n\nRejoin after Down: there is no in-band `RejoinRequested` message, so a node that transitioned\nto Down rejoins by restarting \u2014 or re-booting with the same identity on a fresh transport \u2014 which\nre-announces itself to peers via the per-connection handshake preamble ({@see handshakePreamble()}).\nA long-lived seed re-identifies the returning node without operator intervention. This restart-rejoin\npath is covered by the `departedNodeRejoinsWithSameIdentity` integration test.\";}s:8:\"@example\";a:1:{i:0;s:184:\"\n  $runtime = new FiberRuntime();\n  $system  = ActorSystem::create('my-cluster', $runtime);\n  $node    = ClusterNode::boot($system, $topology);\n  $node->expose($ref);\n  $system->run();\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:51:\"\/app\/packages\/nexus-cluster-tcp\/src\/ClusterNode.php\";s:12:\"dependencies\";a:70:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:22:\"BadMethodCallException\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:51:\"\/app\/packages\/nexus-cluster-tcp\/src\/ClusterNode.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:7:\"Closure\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:51:\"\/app\/packages\/nexus-cluster-tcp\/src\/ClusterNode.php\";s:4:\"line\";i:8;}s:14:\"dependencyType\";r:1878;}}i:2;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:24:\"InvalidArgumentException\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:51:\"\/app\/packages\/nexus-cluster-tcp\/src\/ClusterNode.php\";s:4:\"line\";i:9;}s:14:\"dependencyType\";r:1878;}}i:3;O:51:\"Dep