eference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:35:\"Monadial\\Nexus\\Cluster\\Tcp\\PeerLink\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:3:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:32:\"Monadial\\Nexus\\Cluster\\Tcp\\Frame\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:48:\"\/app\/packages\/nexus-cluster-tcp\/src\/PeerLink.php\";s:4:\"line\";i:31;}s:14:\"dependencyType\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:PARAMETER\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:32:\"Monadial\\Nexus\\Cluster\\Tcp\\Frame\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:48:\"\/app\/packages\/nexus-cluster-tcp\/src\/PeerLink.php\";s:4:\"line\";i:39;}s:14:\"dependencyType\";r:19;}}i:2;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:39:\"Monadial\\Nexus\\Cluster\\Tcp\\NodeEndpoint\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:48:\"\/app\/packages\/nexus-cluster-tcp\/src\/PeerLink.php\";s:4:\"line\";i:60;}s:14:\"dependencyType\";E:62:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:RETURN_TYPE\";}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:431:\"\n\nA bidirectional link between two cluster nodes. Frames flow in both\ndirections; callbacks fire on frame arrival and link closure.\n\nImplementations: LoopbackPeerLink (in-process, C1.3), TcpPeerLink (Swoole, C1.4).\n\nUsage:\n\n  $link->onFrame(function (Frame $frame): void {\n      \/\/ handle incoming frame\n  });\n  $link->onClose(function (): void {\n      \/\/ peer disconnected\n  });\n  $link->sendFrame(new Frame(FrameType::Ping, ''));\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:48:\"\/app\/packages\/nexus-cluster-tcp\/src\/PeerLink.php\";s:12:\"dependencies\";a:0:{}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Swoole\/SwooleMeshTransport.php":{"hash":"498159cafe0134a747074900b31d7757aefef976","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:2:{s:10:\"@psalm-api\";a:1:{i:0;s:1044:\"\n\nSwoole coroutine TCP mesh transport. Implements `MeshTransport` over real\nnetwork sockets using `Swoole\\Coroutine\\Server` (accept-loop) and\n`Swoole\\Coroutine\\Client` (outbound connections).\n\nBoth TLS and plaintext modes are supported. TLS is enabled by passing a\n`TlsConfig` instance to the constructor; plaintext is the default.\n\nSecurity note: plaintext cluster connections must only be used on private,\ntrusted networks. Use TLS for anything exposed beyond a LAN.\n\next-swoole requirement: the constructor throws `RuntimeException` if\next-swoole is not loaded. The rest of the package (loopback transport) works\nwithout Swoole, so this guard ensures tests running on the plain PHP container\nfail fast with a clear message rather than an undefined-class fatal error.\n\nEphemeral ports: for testing, call `bindEphemeral()` before `serve()`.\n`bindEphemeral()` creates the server socket synchronously (OS assigns a port),\nreturns the port, and stores the server for `serve()` to reuse. This avoids\nthe TOCTOU window of probe-and-rebind patterns.\";}s:8:\"@example\";a:1:{i:0;s:293:\"\n  $transport = new SwooleMeshTransport($runtime);\n  $port      = $transport->bindEphemeral(Host::of('127.0.0.1'));\n  $bind      = new NodeEndpoint(Host::of('127.0.0.1'), Port::of($port));\n  $transport->serve($bind, fn(PeerLink $link): void { ... });\n  $link      = $transport->connect($bind);\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:53:\"Monadial\\Nexus\\Cluster\\Tcp\\Swoole\\SwooleMeshTransport\";}s:8:\"inherits\";a:1:{i:0;O:46:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\":4:{s:13:\"classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:40:\"Monadial\\Nexus\\Cluster\\Tcp\\MeshTransport\";}s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:66:\"\/app\/packages\/nexus-cluster-tcp\/src\/Swoole\/SwooleMeshTransport.php\";s:4:\"line\";i:55;}s:4:\"type\";E:61:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInheritType:IMPLEMENTS\";s:52:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\u0000path\";a:0:{}}}s:12:\"dependencies\";a:30:{i:0;O:51:\"Deptrac\\Deptr