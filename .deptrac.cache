ery.php":{"hash":"6dfb97cbc16bbd1ae96f387699bade1d625d0f73","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:336:\"\n\nIngress seam that resolves a target actor path and delivers a decoded message to it.\n`InboxRouter` depends on this interface rather than inlining the registry lookup, so\nthe `LocalActorRegistry`-backed single-`ActorSystem` impl (C1 default) and the future\nhash-ring \u2192 `Thread\\Queue` threaded impl can be swapped in with zero rework.\";}}s:4:\"type\";E:64:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_INTERFACE\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:52:\"Monadial\\Nexus\\Cluster\\Tcp\\Messaging\\InboundDelivery\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:3:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:34:\"Monadial\\Nexus\\Core\\Actor\\ActorRef\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:65:\"\/app\/packages\/nexus-cluster-tcp\/src\/Messaging\/InboundDelivery.php\";s:4:\"line\";i:25;}s:14:\"dependencyType\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:PARAMETER\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\