00Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:16:\"Swoole\\Coroutine\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:77:\"\/app\/packages\/nexus-worker-pool-swoole\/src\/Transport\/ThreadQueueTransport.php\";s:4:\"line\";i:94;}s:14:\"dependencyType\";r:107;}}i:12;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:36:\"Monadial\\Nexus\\Core\\Mailbox\\Envelope\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:77:\"\/app\/packages\/nexus-worker-pool-swoole\/src\/Transport\/ThreadQueueTransport.php\";s:4:\"line\";i:127;}s:14:\"dependencyType\";E:61:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:INSTANCEOF\";}}i:13;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:36:\"Monadial\\Nexus\\Core\\Mailbox\\Envelope\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:77:\"\/app\/packages\/nexus-worker-pool-swoole\/src\/Transport\/ThreadQueueTransport.php\";s:4:\"line\";i:125;}s:14:\"dependencyType\";E:62:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:RETURN_TYPE\";}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:884:\"\n\nThread-safe transport backed by Swoole\\Thread\\Queue.\n\nsend()  \u2014 pushes Envelope to target worker's Queue. Thread\\Queue serializes\n          the object internally via php_serialize; no explicit serializer needed.\n\nlisten() \u2014 registers a handler and spawns an adaptive-poll coroutine that\n           reads from this worker's own Queue. Thread\\Queue::pop() blocks the\n           entire OS thread, so pop(0) (non-blocking) is used with Coroutine::sleep()\n           backoff to remain coroutine-friendly.\n\nAdaptive poll backoff (Swoole minimum sleep is 1 ms):\n  - Messages present    \u2192 continue immediately (no sleep, tight drain loop)\n  - 1\u201399 empty polls    \u2192 1ms sleep  (recently active, check again soon)\n  - 100\u2013999 empty polls \u2192 5ms sleep\n  - 1000+ empty polls   \u2192 10ms sleep (idle steady state)\n  - Message arrives     \u2192 reset counter, return to tight drain loop\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:77:\"\/app\/packages\/nexus-worker-pool-swoole\/src\/Transport\/ThreadQueueTransport.php\";s:12:\"dependencies\";a:6:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:7:\"Closure\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:77:\"\/app\/packages\/nexus-worker-pool-swoole\/src\/Transport\/ThreadQueueTransport.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\