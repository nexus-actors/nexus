me\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:32:\"Monadial\\Nexus\\Cluster\\Tcp\\Frame\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:1:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:36:\"Monadial\\Nexus\\Cluster\\Tcp\\FrameType\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:45:\"\/app\/packages\/nexus-cluster-tcp\/src\/Frame.php\";s:4:\"line\";i:15;}s:14:\"dependencyType\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:PARAMETER\";}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:142:\"\n\nA single cluster TCP frame. The payload is opaque msgpack bytes \u2014 the codec\nonly moves raw bytes; higher layers (de)serialize the payload.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:45:\"\/app\/packages\/nexus-cluster-tcp\/src\/Frame.php\";s:12:\"dependencies\";a:0:{}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/FrameCodec.php":{"hash":"b0030b5847b637cc291804d06e0c2e31f89f6595","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:858:\"\n\nEncodes and incrementally decodes length-prefixed cluster TCP frames.\n\nWire format (per frame):\n  [4 bytes big-endian uint32: body length] [1 byte: FrameType value] [N bytes: msgpack payload]\n\nThe 4-byte length covers the type byte plus the payload \u2014 i.e.\n`body_length = 1 + strlen($payload)`.\n\n`decodeStream` is incremental: it consumes as many complete frames as the\nbuffer contains and returns any trailing partial frame in `rest`. Callers\nfeed `rest` back on the next read, enabling byte-by-byte reassembly without\ncopies beyond the buffer.\n\n`maxFrameSize` bounds the declared body length: a peer that declares a larger\nframe is rejected at the 4-byte prefix, before its body is buffered, so per-link\nreassembly memory stays bounded by this value. It is wired from\n`ClusterTopology::withMaxFrameSize()` through `SwooleMeshTransport`\/`SwoolePeerLink`.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:37:\"Monadial\\Nexus\\Cluster\\Tcp\\FrameCodec\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:22:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FunctionToken\":1:{s:12:\"functionName\";s:6:\"strlen\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:50:\"\/app\/packages\/nexus-cluster-tcp\/src\/FrameCodec.php\";s:4:\"line\";i:57;}s:14:\"dependencyType\";E:75:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:UNRESOLVED_FUNCTION_CALL\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FunctionToken\":1:{s:12:\"functionName\";s:7:\"sprintf\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14