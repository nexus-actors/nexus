ce\":2:{s:8:\"filepath\";s:66:\"\/app\/packages\/nexus-worker-pool-swoole\/src\/WorkerPoolBootstrap.php\";s:4:\"line\";i:14;}s:14:\"dependencyType\";r:330;}}i:8;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:19:\"Swoole\\Thread\\Queue\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:66:\"\/app\/packages\/nexus-worker-pool-swoole\/src\/WorkerPoolBootstrap.php\";s:4:\"line\";i:15;}s:14:\"dependencyType\";r:330;}}}}"},"\/app\/packages\/nexus-worker-pool-swoole\/src\/WorkerRunnable.php":{"hash":"667f7950da4bf823640a21b019c031710b340639","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:1121:\"\n\nThread entrypoint for each worker in the pool.\n\nSwoole\\Thread\\Pool constructs each Runnable with exactly\n(Atomic $running, int $index) and then invokes run($args), where $args is\nthe array provided via Pool::withArguments(). All worker dependencies must\ntherefore travel through $args \u2014 they cannot be injected via the constructor.\n\nArgument layout (matches WorkerPoolBootstrap::runWithPool()):\n  [0] Map       $directory\n  [1] ArrayList $queues             \u2014 Swoole converts PHP array \u2192 ArrayList\n  [2] Atomic    $workerIdCounter\n  [3] int       $workerCount        \u2014 scalars used to rebuild WorkerPoolConfig\n  [4] string    $systemNamePrefix\n  [5] string    $handlerClass\n  [6] string    $serializedConfigure\n  [7] string    $loggerClass\n  [8] string    $serializedLoggerFactory\n\nThe parent Runnable defines $running and $id; we inherit its constructor\nunchanged and do all real work inside run().\n\nIMPORTANT: Do NOT wrap the body in Swoole\\Coroutine\\run() \u2014 $system->run()\nstarts the Swoole event loop itself, and nesting another run() inside a\ncoroutine raises \"Unable to call Event::wait() in coroutine\".\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:47:\"Monadial\\Nexus\\WorkerPool\\Swoole\\WorkerRunnable\";}s:8:\"inherits\";a:1:{i:0;O:46:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\":4:{s:13:\"classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:22:\"Swoole\\Thread\\Runnable\";}s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:61:\"\/app\/packages\/nexus-worker-pool-swoole\/src\/WorkerRunnable.php\";s:4:\"line\";i:55;}s:4:\"type\";E:58:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInheritType:EXTENDS\";s:52:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\u0000path\";a:0:{}}}s:12:\"dependencies\";a:37:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:17:\"Swoole\\Thread\\Map\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:61:\"\/app\/packages\/nexus-worker-pool-swoole\/src\/