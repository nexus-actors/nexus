ult.\n\nOnly fires when the closure's first parameter is a TGenericObject for\n`ActorContext` whose single template argument is a concrete named class.\nFalls through for bare `ActorContext` (no generic), unions, or the\nbare `object` keyword (parsed as TObject, rejected by the\n`!instanceof TNamedObject` guard) \u2014 never widens past Psalm's default.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-psalm\/src\/Hook\/BehaviorSetupReturnTypeProvider.php\";s:12:\"dependencies\";a:10:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:38:\"Monadial\\Nexus\\Core\\Actor\\ActorContext\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-psalm\/src\/Hook\/BehaviorSetupReturnTypeProvider.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:34:\"Monadial\\Nexus\\Core\\Actor\\Behavior\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:70:\"\/app\/packages\/nexus-psalm\/src\/Hook\/BehaviorSetupReturnTypeProvider.php\";s:4:\"line\";i:8;}s:14:\"dependencyType\";r:222;}}i:2;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyTo