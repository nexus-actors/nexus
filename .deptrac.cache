ar map serialised into the \/health JSON\nresponse so dashboards can surface backing-service info (last seen\ntimestamps, hit ratios, queue depths) without parsing log lines.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:47:\"Monadial\\Nexus\\Http\\Toolkit\\Health\\HealthStatus\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:5:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:40:\"Monadial\\Nexus\\Http\\Toolkit\\Health\\State\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:60:\"\/app\/packages\/nexus-http-toolkit\/src\/Health\/HealthStatus.php\";s:4:\"line\";i:24;}s:14:\"dependencyType\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:PARAMETER\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:40:\"Monadial\\Nexus\\Http\\Toolkit\\Health\\State\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:60:\"\/app\/packages\/nexus-http-toolkit\/src\/Health\/HealthStatus.php\";s:4:\"line\";i:29;}s:14:\"dependencyType\";E:56:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:CONST\";