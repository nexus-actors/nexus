s\";a:1:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:8:\"Override\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:69:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/RandomPeerSelector.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/ShuffledCycleSelector.php":{"hash":"03e29d2066e2d245cb343af2d19efe9c64becc9e","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:1068:\"\n\nShuffled-cycle gossip peer selection: walks a random permutation of the peer\nset and reshuffles when the pass is exhausted (the probe ordering used by\nSWIM-family implementations such as HashiCorp memberlist).\n\nUniform-random selection ({@see RandomPeerSelector}) makes per-peer gossip\ninter-arrival EXPONENTIAL: with fan-out 3 of 15 peers the mean gap is short,\nbut the tail is unbounded \u2014 P(gap > maxNoHeartbeat) is ~2% per gap, so a\ndata-IDLE mesh continuously false-suspects healthy peers (measured at ~1.7\nsuspicions\/s across a 16-node idle mesh; data-plane traffic masks it by\nfeeding the liveness path on every link). Cycling a permutation instead\nbounds the gap DETERMINISTICALLY: every peer is selected at least once per\npass of ceil(N\/count) consecutive selects, so a healthy idle link can never\nfall silent past the failure detector's thresholds.\n\nStateful by design; the MembershipActor that owns it is single-threaded, so\nno synchronisation is needed. Peers that depart mid-pass are dropped from\nthe current pass; new peers join at the next reshuffle.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:59:\"Monadial\\Nexus\\Cluster\\Tcp\\Membership\\ShuffledCycleSelector\";}s:8:\"inherits\";a:1:{i:0;O:46:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\":4:{s:13:\"classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:50:\"Monadial\\Nexus\\Cluster\\Tcp\\Membership\\PeerSelector\";}s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:72:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/ShuffledCycleSelector.php\";s:4:\"line\";i:38;}s:4:\"type\";E:61:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInheritType:IMPLEMENTS\";s:52:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\AstInherit\u0000path\";a:0:{}}}s:12:\"dependencies\";a:10:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FunctionToken\":1:{s:12:\"functionName\";s:5:\"count\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:72:\"\/app\/packages\/nexus-cluster-tcp\/src\/Membership\/ShuffledCycleSelector.php\";s:4:\"line\";i:55;}s:14:\"dependencyType\";E:75:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:UNRESOLVED_FUNCTION_CALL\";}}i:1;O:51:\"De