:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FunctionToken\":1:{s:12:\"functionName\";s:6:\"substr\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:50:\"\/app\/packages\/nexus-cluster-tcp\/src\/FrameCodec.php\";s:4:\"line\";i:143;}s:14:\"dependencyType\";r:19;}}i:20;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:32:\"Monadial\\Nexus\\Cluster\\Tcp\\Frame\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:50:\"\/app\/packages\/nexus-cluster-tcp\/src\/FrameCodec.php\";s:4:\"line\";i:93;}s:14:\"dependencyType\";E:62:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:RETURN_TYPE\";}}i:21;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:54:\"Monadial\\Nexus\\Cluster\\Tcp\\Exception\\ProtocolException\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:50:\"\/app\/packages\/nexus-cluster-tcp\/src\/FrameCodec.php\";s:4:\"line\";i:93;}s:14:\"dependencyType\";r:59;}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:858:\"\n\nEncodes and incrementally decodes length-prefixed cluster TCP frames.\n\nWire format (per frame):\n  [4 bytes big-endian uint32: body length] [1 byte: FrameType value] [N bytes: msgpack payload]\n\nThe 4-byte length covers the type byte plus the payload \u2014 i.e.\n`body_length = 1 + strlen($payload)`.\n\n`decodeStream` is incremental: it consumes as many complete frames as the\nbuffer contains and returns any trailing partial frame in `rest`. Callers\nfeed `rest` back on the next read, enabling byte-by-byte reassembly without\ncopies beyond the buffer.\n\n`maxFrameSize` bounds the declared body length: a peer that declares a larger\nframe is rejected at the 4-byte prefix, before its body is buffered, so per-link\nreassembly memory stays bounded by this value. It is wired from\n`ClusterTopology::withMaxFrameSize()` through `SwooleMeshTransport`\/`SwoolePeerLink`.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:50:\"\/app\/packages\/nexus-cluster-tcp\/src\/FrameCodec.php\";s:12:\"dependencies\";a:1:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:54:\"Monadial\\Nexus\\Cluster\\Tcp\\Exception\\ProtocolException\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:50:\"\/app\/packages\/nexus-cluster-tcp\/src\/FrameCodec.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/FrameType.php":{"hash":"f6c308b00b8b3aa51c6d296b274193aa09b1766d","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:109:\"\n\nIdentifies the purpose of a cluster TCP frame.\nThe backing integer is written as a single byte on the wire.\";}}s:4:\"type\";E:64:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASSLIKE\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:36:\"Monadial\\Nexus\\Cluster\\Tcp\\FrameType\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:0:{}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:109:\"\n\nIdentifies the purpose of a cluster TCP frame.\nThe backing integer is written as a single byte on the wire.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:49:\"\/app\/packages\/nexus-cluster-tcp\/src\/FrameType.php\";s:12:\"dependencies\";a:0:{}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/LinkState.php":{"hash":"72a426bfa997e17e8f6dc4e4ca072c899af0e111","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:9:\"@internal\";a:1:{i:0;s:553:\"\n\nPer-link mutable state for the frame pump: the peer identity learned from the link's first\nHandshake, and the message ingress created once that identity is known. It replaces the\nby-reference closure captures the inbound and outbound frame handlers each used to carry\nseparately, so both can drive one shared {@see ClusterNode::handleLinkFrame()} state machine\ninstead of duplicating it (and drifting \u2014 the two copies had already diverged on which guards\nthey applied). Deliberately mutable: it tracks the evolving state of a single live connection.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:36:\"Monadial\\Nexus\\Cluster\\Tcp\\LinkState\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:2:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:34:\"Monadial\\Nexus\\Cluster\\NodeAddress\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:49:\"\/app\/packages\/nexus-cluster-tcp\/src\/LinkState.php\";s:4:\"line\";i:22;}s:14:\"dependencyType\";E:59:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:VARIABLE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:49:\"Monadial\\Nexus\\Cluster\\Tcp\\Messaging\\FrameIngress\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:49:\"\/app\/packages\/nexus-cluster-tcp\/src\/LinkState.php\";s:4:\"line\";i:24;}s:14:\"dependencyType\";r:19;}}}s:4:\"tags\";a:1:{s:9:\"@internal\";a:1:{i:0;s:553:\"\n\nPer-link mutable state for the frame pump: the peer identity learned from the link's first\nHandshake, and the message ingress created once that identity is known. It replaces the\nby-reference closure captures the inbound and outbound frame handlers each used to carry\nseparately, so both can drive one shared {@see ClusterNode::handleLinkFrame()} state machine\ninstead of duplicating it (and drifting \u2014 the two copies had already diverged on which guards\nthey applied). Deliberately mutable: it tracks the evolving state of a single live connection.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:49:\"\/app\/packages\/nexus-cluster-tcp\/src\/LinkState.php\";s:12:\"dependencies\";a:2:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:34:\"Monadial\\Nexus\\Cluster\\NodeAddress\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:49:\"\/app\/packages\/nexus-cluster-tcp\/src\/LinkState.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:49:\"Monadial\\Nexus\\Cluster\\Tcp\\Messaging\\FrameIngress\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:49:\"\/app\/packages\/nexus-cluster-tcp\/src\/LinkState.php\";s:4:\"line\";i:8;}s:14:\"dependencyType\";r:42;}}}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Loopback\/LoopbackHub.php":{"hash":"9f337953e1e7b3d6cc3f09c5ff94de77db2cef11","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:696:\"\n\nShared in-process registry that maps endpoint strings to their active\nserve() listeners. Multiple LoopbackMeshTransport instances share one hub\nso that node A can connect() to node B's serve() listener.\n\nThe hub is the single object that crosses transport boundaries. Inject one\ninstance into every transport that forms a loopback cluster:\n\n  $hub  = new LoopbackHub();\n  $nodeA = new LoopbackMeshTransport($hub, $runtime);\n  $nodeB = new LoopbackMeshTransport($hub, $runtime);\n\nDesign note: per-transport-instance state cannot work for multi-node\nloopback because each transport only knows about its own listeners; the hub\nis the rendezvous point that makes cross-transport connect() possible.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:47:\"Monadial\\Nexus\\Cluster\\Tcp\\Loopback\\LoopbackHub\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:7:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:35:\"Monadial\\Nexus\\Cluster\\Tcp\\PeerLink\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\"