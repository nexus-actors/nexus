 (cold remote dependencies), wrap the\ncheck in an actor that polls in the background and caches the\nlatest result.\";}}s:4:\"type\";E:64:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_INTERFACE\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:46:\"Monadial\\Nexus\\Http\\Toolkit\\Health\\HealthCheck\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:1:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:47:\"Monadial\\Nexus\\Http\\Toolkit\\Health\\HealthStatus\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:59:\"\/app\/packages\/nexus-http-toolkit\/src\/Health\/HealthCheck.php\";s:4:\"line\";i:26;}s:14:\"dependencyType\";E:62:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:RETURN_TYPE\";}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:341:\"\n\nOne probe. Implementations return a HealthStatus describing whether\nthe check passed and an optional structured detail body.\n\nKeep checks fast \u2014 they are called synchronously on every \/health\nrequest. For expensive backends (cold remote dependencies), wrap the\ncheck in an actor that polls in the background and caches the\nlatest result.\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:59:\"\/app\/packages\/nexus-http-toolkit\/src\/Health\/HealthCheck.php\";s:12:\"dependencies\";a:0:{}}"},"\/app\/packages\/nexus-http-toolkit\/src\/Health\/HealthCheckHandler.php":{"hash":"9922b5a53d26dbf58b7bf98ca82963275e618ba8","reference":"O:49:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileReference\":4:{s:19:\"classLikeReferences\";a:1:{i:0;O:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\":7:{s:62:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\TaggedTokenReference\u0000tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:731:\"\n\nInvokable handler \u2014 register against a route to serve the aggregate\nhealth endpoint:\n\n  $registry = (new HealthCheckRegistry())\n      ->add(new DatabaseHealthCheck($pdo))\n      ->add(new RedisHealthCheck($redis));\n\n  $app->get('\/health', new HealthCheckHandler($registry));\n\nResponse shape (RFC-health-json-inspired):\n\n  200 OK  (everything up or degraded)\n  503     (any check is down)\n\n  {\n    \"status\": \"up\" | \"degraded\" | \"down\",\n    \"checks\": {\n      \"database\": {\"state\": \"up\",   \"detail\": {\"latencyMs\": 1.2}},\n      \"redis\":    {\"state\": \"down\", \"detail\": {\"error\": \"connection refused\"}}\n    }\n  }\n\nA check that THROWS is treated as down; the exception class becomes\nthe `error` detail. The handler itself never throws.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:53:\"Monadial\\Nexus\\Http\\Toolkit\\Health\\HealthCheckHandler\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:10:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:54:\"Monadial\\Nexus\\Http\\Toolkit\\Health\\HealthCheckRegistry\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract