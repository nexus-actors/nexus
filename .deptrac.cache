:create($system)\n      ->get('\/orders\/{id}', ShowOrderHandler::class)\n      ->compile();\n\n  $response = HttpTestClient::for($app)\n      ->withHeader('Authorization', 'Bearer xyz')\n      ->get('\/orders\/42');\n\n  $response->assertOk()->assertJsonPath('id', '42');\n\nPair with StepRuntime for fully deterministic test runs: the actor\nsystem runs step()\/drain() between assertions, so request handling\ndoesn't depend on wall-clock or fiber scheduling.\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:47:\"Monadial\\Nexus\\Http\\Toolkit\\Test\\HttpTestClient\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:19:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:32:\"Nyholm\\Psr7\\Factory\\Psr17Factory\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:60:\"\/app\/packages\/nexus-http-toolkit\/src\/Test\/HttpTestClient.php\";s:4:\"line\";i:43;}s:14:\"dependencyType\";E:59:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:VARIABLE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:32:\"Nyholm\\Psr7\\Factory\\Psr17Factory\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"