0;s:335:\"\n\nOptional TLS configuration for Swoole TCP cluster connections.\nWhen set on ClusterTopology, the cluster server and outbound peer connections\nenable SSL using the Swoole socket SSL options.\n\nSecurity note: plaintext cluster ports must never be exposed to untrusted\nnetworks. Use TLS + network policy for anything beyond a private LAN.\";}s:8:\"@example\";a:1:{i:0;s:144:\"\n$tls = new TlsConfig(\n    certFile: '\/certs\/node.crt',\n    keyFile:  '\/certs\/node.key',\n    caFile:   '\/certs\/ca.crt',\n    verifyPeer: true,\n);\";}}s:4:\"type\";E:60:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeType:TYPE_CLASS\";s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000classLikeName\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:36:\"Monadial\\Nexus\\Cluster\\Tcp\\TlsConfig\";}s:8:\"inherits\";a:0:{}s:12:\"dependencies\";a:0:{}s:4:\"tags\";a:2:{s:10:\"@psalm-api\";a:1:{i:0;s:335:\"\n\nOptional TLS configuration for Swoole TCP cluster connections.\nWhen set on ClusterTopology, the cluster server and outbound peer connections\nenable SSL using the Swoole socket SSL options.\n\nSecurity note: plaintext cluster ports must never be exposed to untrusted\nnetworks. Use TLS + network policy for anything beyond a private LAN.\";}s:8:\"@example\";a:1:{i:0;s:144:\"\n$tls = new TlsConfig(\n    certFile: '\/certs\/node.crt',\n    keyFile:  '\/certs\/node.key',\n    caFile:   '\/certs\/ca.crt',\n    verifyPeer: true,\n);\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:49:\"\/app\/packages\/nexus-cluster-tcp\/src\/TlsConfig.php\";s:12:\"dependencies\";a:0:{}}"},"\/app\/packages\/nexus-cluster-tcp\/src\/Tracing\/ObservabilityTraceContextExtractor.php":{"hash":"308fdeaa3a9dcdcd6d9f191bbe9b43999d073787","reference":"O:49:\"Deptra