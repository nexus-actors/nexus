/Payload\/MessagePayloadCodec.php\";s:4:\"line\";i:70;}s:14:\"dependencyType\";r:19;}}i:9;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:70:\"Monadial\\Nexus\\Serialization\\Exception\\MessageDeserializationException\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:67:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/MessagePayloadCodec.php\";s:4:\"line\";i:63;}s:14:\"dependencyType\";r:59;}}i:10;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:49:\"Monadial\\Nexus\\Cluster\\Tcp\\Payload\\MessagePayload\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:67:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/MessagePayloadCodec.php\";s:4:\"line\";i:63;}s:14:\"dependencyType\";E:62:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:RETURN_TYPE\";}}}s:4:\"tags\";a:1:{s:10:\"@psalm-api\";a:1:{i:0;s:1141:\"\n\nHand-rolled msgpack codec for the {@see MessagePayload} envelope \u2014 the cluster's\nper-message hot path.\n\nThe generic {@see \\Monadial\\Nexus\\Serialization\\Msgpack\\MessagePackMessageSerializer}\nroutes every object through Valinor (normalizer out, TreeMapper in). That is the right\ntool for arbitrary user message types, but the envelope is a fixed six-field internal\nVO and the mapper's reflection-driven hydration dominated the receive path (~12 \u00b5s of a\n~32 \u00b5s per-message budget in the loopback benchmark). This codec packs and unpacks the\nsame msgpack map directly, cutting the envelope cost to raw msgpack + validation.\n\nWire compatibility: both codecs produce a msgpack map with the same six keys, and both\nreaders resolve fields by key (never by position), so nodes using either codec interop\nfreely \u2014 covered by cross-decoding tests in both directions.\n\nTrust boundary: `unpack()` consumes bytes straight off the network. Every field is\ntype-checked before the VO is constructed; any mismatch throws\n{@see MessageDeserializationException}, which the frame ingress treats as an\nundecodable frame (dropped and logged, never routed).\";}}s:69:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeReference\u0000fileReference\";r:1;}}s:18:\"functionReferences\";a:0:{}s:8:\"filepath\";s:67:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/MessagePayloadCodec.php\";s:12:\"dependencies\";a:4:{i:0;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:70:\"Monadial\\Nexus\\Serialization\\Exception\\MessageDeserializationException\";}s:7:\"context\";O:53:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyContext\":2:{s:14:\"fileOccurrence\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\FileOccurrence\":2:{s:8:\"filepath\";s:67:\"\/app\/packages\/nexus-cluster-tcp\/src\/Payload\/MessagePayloadCodec.php\";s:4:\"line\";i:7;}s:14:\"dependencyType\";E:54:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyType:USE\";}}i:1;O:51:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\DependencyToken\":2:{s:5:\"token\";O:50:\"Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\":1:{s:61:\"\u0000Deptrac\\Deptrac\\Contract\\Ast\\AstMap\\ClassLikeToken\u0000className\";s:68:\"Monadial\\Nexus\\Serialization\\Exception\\MessageSerializationException\";}s:7:\"c