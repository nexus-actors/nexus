---
import Base from '../layouts/Base.astro';
import BootstrapWizard from '../components/BootstrapWizard';
---
<Base
  title="Bootstrap your Nexus app · in four steps"
  description="Tell us what you're building. We'll generate the composer command, the bootstrap file, the docker-compose stub, and the run instructions."
>
  <section class="bootstrap-hero">
    <div class="bootstrap-hero-inner">
      <h1 class="bootstrap-title">Bootstrap your Nexus app · <span class="bootstrap-title-accent">in four steps</span></h1>
      <p class="bootstrap-subtitle">
        Tell us what you're building. We'll generate the <code>composer require</code> command,
        the bootstrap file, the docker-compose stub, and the run instructions.
      </p>
    </div>
  </section>

  <section class="bootstrap-wizard-section">
    <div class="bootstrap-wizard-inner">
      <BootstrapWizard client:load />
    </div>
  </section>
</Base>

<style>
  .bootstrap-hero {
    border-bottom: 1px solid var(--nx-border);
    background: var(--nx-bg-raised);
    padding: 4rem 2rem 3rem;
  }

  .bootstrap-hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .bootstrap-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--nx-text);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .bootstrap-title-accent {
    color: var(--nx-accent);
  }

  .bootstrap-subtitle {
    font-size: 1.05rem;
    color: var(--nx-text-muted);
    line-height: 1.7;
    margin: 0;
    max-width: 640px;
  }

  .bootstrap-subtitle code {
    font-family: var(--nx-font-mono);
    font-size: 0.92em;
    background: var(--nx-code-bg, rgba(16, 185, 129, 0.08));
    color: var(--nx-accent);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }

  .bootstrap-wizard-section {
    padding: 3rem 2rem 5rem;
  }

  .bootstrap-wizard-inner {
    max-width: 860px;
    margin: 0 auto;
  }
</style>
