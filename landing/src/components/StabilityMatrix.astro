---
// landing/src/components/StabilityMatrix.astro
import { docsUrl } from '../lib/urls';

interface Package {
  name: string;
  stability: 'Stable' | 'Experimental';
  ztsRequired: boolean;
  description: string;
}

const ZTS_DOCS = docsUrl('/operations/zts-php-setup');

const PACKAGES: Package[] = [
  { name: 'nexus-actors/core', stability: 'Stable', ztsRequired: false, description: 'Actor model foundation — Behavior, ActorRef, ActorSystem, mailbox, supervision' },
  { name: 'nexus-actors/runtime', stability: 'Stable', ztsRequired: false, description: 'Shared runtime abstractions — Runtime, Duration, Cancellable, mailbox contracts' },
  { name: 'nexus-actors/runtime-fiber', stability: 'Stable', ztsRequired: false, description: 'PHP Fiber runtime — cooperative multitasking, no Swoole required' },
  { name: 'nexus-actors/runtime-swoole', stability: 'Stable', ztsRequired: false, description: 'Swoole coroutine runtime for production async I/O' },
  { name: 'nexus-actors/runtime-step', stability: 'Stable', ztsRequired: false, description: 'Deterministic step runtime for unit testing' },
  { name: 'nexus-actors/app', stability: 'Stable', ztsRequired: false, description: 'PSR-11 application bootstrap (NexusApp builder)' },
  { name: 'nexus-actors/serialization', stability: 'Stable', ztsRequired: false, description: 'Message and envelope serialization (PHP native, Valinor)' },
  { name: 'nexus-actors/persistence', stability: 'Experimental', ztsRequired: false, description: 'Event sourcing and durable state core — EventSourcedBehavior, DurableStateBehavior' },
  { name: 'nexus-actors/persistence-dbal', stability: 'Experimental', ztsRequired: false, description: 'DBAL-backed event store, snapshot store, and durable state store' },
  { name: 'nexus-actors/persistence-doctrine', stability: 'Experimental', ztsRequired: false, description: 'Doctrine ORM-backed event store, snapshot store, and durable state store' },
  { name: 'nexus-actors/worker-pool', stability: 'Experimental', ztsRequired: false, description: 'Multi-worker pool — WorkerNode, ConsistentHashRing, WorkerActorRef' },
  { name: 'nexus-actors/worker-pool-swoole', stability: 'Experimental', ztsRequired: true, description: 'Swoole thread-based worker pool transport (WorkerPoolApp, ThreadQueueTransport)' },
  { name: 'nexus-actors/http', stability: 'Stable', ztsRequired: false, description: 'HTTP routing core — HttpApp DSL, handler/param resolution, middleware pipeline' },
  { name: 'nexus-actors/http-server-swoole', stability: 'Stable', ztsRequired: false, description: 'Swoole worker-mode HTTP server adapter (SwooleHttpServerAdapter)' },
  { name: 'nexus-actors/http-server-swoole-threads', stability: 'Stable', ztsRequired: true, description: 'Swoole thread-mode HTTP server with graceful-shutdown hooks (multi-core)' },
  { name: 'nexus-actors/http-auth', stability: 'Stable', ztsRequired: false, description: 'HTTP authentication middleware — bearer token, Principal, #[FromPrincipal]' },
  { name: 'nexus-actors/http-ws', stability: 'Experimental', ztsRequired: false, description: 'WebSocket DSL — WsApplication, WebSocket handler, actor-backed connections' },
  { name: 'nexus-actors/http-toolkit', stability: 'Stable', ztsRequired: false, description: 'Reusable HTTP middlewares — CORS, rate limit, body size limit, helper resolvers' },
  { name: 'nexus-actors/doctrine-dbal', stability: 'Stable', ztsRequired: false, description: 'Coroutine-aware DBAL connection pool + HTTP middleware + #[Transactional]' },
  { name: 'nexus-actors/doctrine-orm', stability: 'Stable', ztsRequired: false, description: 'Pooled EntityManager injection + EntityBehavior DSL for aggregate actors' },
  { name: 'nexus-actors/logger', stability: 'Stable', ztsRequired: false, description: 'Async PSR-3 logger backed by LogActor mailbox with Monolog-compatible handlers' },
  { name: 'nexus-actors/cluster', stability: 'Experimental', ztsRequired: false, description: 'Remote actor contracts — NodeAddress, ClusterTransport, NodeDirectory (API preview; not production-ready)' },
  { name: 'nexus-actors/cluster-tcp', stability: 'Experimental', ztsRequired: false, description: 'Swoole TCP cluster mesh — gossip membership, phi-accrual failure detection, ClusterRef (not production-ready)' },
  { name: 'nexus-actors/psalm', stability: 'Stable', ztsRequired: false, description: 'Psalm plugin — ReadonlyMessage, MutableState, BlockingCall, and PropsReturnType rules' },
  { name: 'nexus-actors/skeleton', stability: 'Stable', ztsRequired: false, description: 'Project skeleton — composer create-project starter with interactive bootstrap wizard' },
  { name: 'nexus-actors/nexus', stability: 'Stable', ztsRequired: false, description: 'Meta-package — installs nexus-actors/core, runtime, runtime-fiber, and serialization in one step' },
];
---

<p class="mb-3 text-sm text-slate-600 dark:text-slate-400">
  Nexus is pre-1.0. "Stable" means the package's API is settled within the current
  development line — it is not a production-hardening claim. All packages may change
  before 1.0.
</p>
<div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
  <table class="min-w-full text-sm">
    <thead>
      <tr class="bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
        <th scope="col" class="px-4 py-3 text-left font-semibold text-slate-700 dark:text-slate-300 whitespace-nowrap">Package</th>
        <th scope="col" class="px-4 py-3 text-left font-semibold text-slate-700 dark:text-slate-300 whitespace-nowrap">Stability</th>
        <th scope="col" class="px-4 py-3 text-left font-semibold text-slate-700 dark:text-slate-300">Description</th>
        <th scope="col" class="px-4 py-3 text-left font-semibold text-slate-700 dark:text-slate-300 whitespace-nowrap">Notes</th>
      </tr>
    </thead>
    <tbody>
      {PACKAGES.map((pkg, i) => (
        <tr class={`border-b border-slate-100 dark:border-slate-800 ${i % 2 === 0 ? '' : 'bg-slate-50/50 dark:bg-slate-800/30'}`}>
          <td class="px-4 py-3 font-mono text-xs text-slate-800 dark:text-slate-200 whitespace-nowrap">
            {pkg.name}
          </td>
          <td class="px-4 py-3 whitespace-nowrap">
            {pkg.stability === 'Stable' ? (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
                <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
                Stable
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
                <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                </svg>
                Experimental
              </span>
            )}
          </td>
          <td class="px-4 py-3 text-slate-600 dark:text-slate-400">
            {pkg.description}
          </td>
          <td class="px-4 py-3 text-xs">
            {pkg.ztsRequired ? (
              <a
                href={ZTS_DOCS}
                class="inline-flex items-center gap-1 text-amber-600 dark:text-amber-400 hover:underline underline-offset-2"
              >
                <svg class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                </svg>
                Requires ZTS PHP
              </a>
            ) : (
              <span class="text-slate-400">—</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
