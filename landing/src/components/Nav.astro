---
import { docsUrl } from '../lib/urls';
import NavDropdown from './NavDropdown';
import MobileNav from './MobileNav';
import ThemeToggle from './ThemeToggle';

const integrationsItems = [
  { label: 'HTTP', href: '/http', description: 'PSR-15 routing with actor handlers' },
  { label: 'Doctrine', href: '/doctrine', description: 'DBAL & ORM event stores' },
  { label: 'Observability', href: '/observability', description: 'OpenTelemetry traces, metrics & logs' },
];

const learnItems = [
  { label: 'Why Nexus', href: '/why-nexus', description: 'The case for typed actors in PHP' },
  { label: 'Security', href: '/security', description: 'Isolation, supervision, single-writer' },
  { label: 'Comparison', href: '/comparison', description: 'How Nexus stacks up vs alternatives' },
  { label: 'Stability', href: '/stability', description: 'Package tiers and semver promise' },
  { label: 'Use Cases', href: '/use-cases', description: 'Six real-world patterns' },
  { label: 'Adoption', href: '/adoption', description: 'How to evaluate and adopt Nexus' },
];
---
<nav class="border-b border-slate-200 dark:border-slate-700 sticky top-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur z-50">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between relative">
    <!-- Brand mark: never wraps -->
    <a href="/" class="flex items-center gap-2 flex-shrink-0 whitespace-nowrap mr-8">
      <img src="/logo.svg" alt="Nexus" width="32" height="32" class="h-8 w-8 flex-shrink-0" />
      <span class="font-bold text-lg font-mono tracking-tight">Nexus</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-6">
      <!-- Bootstrap CTA pill -->
      <a
        href="/bootstrap"
        class="whitespace-nowrap flex-shrink-0 text-sm font-semibold text-emerald-600 dark:text-emerald-400 border border-emerald-500 rounded-full px-4 py-1.5 hover:bg-emerald-500 hover:text-white dark:hover:bg-emerald-500 dark:hover:text-white hover:shadow-[0_0_8px_rgba(16,185,129,0.4)] transition-all duration-150"
      >
        Bootstrap
      </a>

      <!-- Integrations dropdown -->
      <NavDropdown label="Integrations" items={integrationsItems} client:load />

      <!-- Learn dropdown -->
      <NavDropdown label="Learn" items={learnItems} client:load />

      <!-- Docs (external) -->
      <a
        href={docsUrl()}
        class="whitespace-nowrap flex-shrink-0 text-sm text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors duration-150"
      >
        Docs
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/nexus-actors/nexus"
        rel="noopener noreferrer"
        target="_blank"
        class="whitespace-nowrap flex-shrink-0 text-sm text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors duration-150 flex items-center gap-1.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 flex-shrink-0" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        GitHub
      </a>

      <!-- Theme toggle -->
      <ThemeToggle client:load />
    </div>

    <!-- Mobile hamburger + menu -->
    <MobileNav docsHref={docsUrl()} client:load />
  </div>
</nav>
