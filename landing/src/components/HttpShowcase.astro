    text-align: center;
  }

  .hs-cta a {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--nx-accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .hs-cta a:hover {
    opacity: 0.75;
    text-decoration: underline;
  }
</style>
