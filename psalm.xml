<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="true"
    reportMixedIssues="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="packages/nexus-app/src" />
        <directory name="packages/nexus-cluster/src" />
        <directory name="packages/nexus-cluster-tcp/src" />
        <directory name="packages/nexus-core/src" />
        <directory name="packages/nexus-doctrine-dbal/src" />
        <directory name="packages/nexus-doctrine-orm/src" />
        <directory name="packages/nexus-http/src" />
        <directory name="packages/nexus-http-auth/src" />
        <directory name="packages/nexus-http-server-swoole/src" />
        <directory name="packages/nexus-http-server-swoole-threads/src" />
        <directory name="packages/nexus-http-toolkit/src" />
        <directory name="packages/nexus-http-ws/src" />
        <directory name="packages/nexus-logger/src" />
        <directory name="packages/nexus-messenger/src" />
        <directory name="packages/nexus-messenger-console/src" />
        <directory name="packages/nexus-messenger-console-swoole/src" />
        <directory name="packages/nexus-observability/src" />
        <directory name="packages/nexus-observability-actor/src" />
        <directory name="packages/nexus-observability-doctrine/src" />
        <directory name="packages/nexus-observability-http/src" />
        <directory name="packages/nexus-observability-logger/src" />
        <directory name="packages/nexus-observability-otel/src" />
        <directory name="packages/nexus-observability-persistence/src" />
        <directory name="packages/nexus-observability-serialization/src" />
        <directory name="packages/nexus-observability-swoole/src" />
        <directory name="packages/nexus-observability-worker-pool/src" />
        <directory name="packages/nexus-persistence/src" />
        <directory name="packages/nexus-persistence-dbal/src" />
        <directory name="packages/nexus-persistence-doctrine/src" />
        <directory name="packages/nexus-psalm/src" />
        <directory name="packages/nexus-runtime/src" />
        <directory name="packages/nexus-runtime-fiber/src" />
        <directory name="packages/nexus-runtime-step/src" />
        <directory name="packages/nexus-runtime-swoole/src" />
        <directory name="packages/nexus-serialization/src" />
        <directory name="packages/nexus-serialization-msgpack/src" />
        <directory name="packages/nexus-skeleton/src" />
        <directory name="packages/nexus-worker-pool/src" />
        <directory name="packages/nexus-worker-pool-swoole/src" />
        <directory name="examples" />
        <directory name="packages/nexus-worker-pool-swoole/bin" />
        <ignoreFiles allowMissingFiles="true">
            <directory name="vendor" />
            <!-- example apps keep their own installs/caches; their tests and perf
                 harnesses are entrypoint-style code outside findUnusedCode's model -->
            <directory name="examples/nexus-cluster-tcp/vendor" />
            <directory name="examples/nexus-messenger-redis/vendor" />
            <directory name="examples/nexus-tictactoe/vendor" />
            <directory name="examples/nexus-tictactoe/var" />
            <directory name="examples/nexus-tictactoe/tests" />
            <directory name="examples/nexus-wallet-app/vendor" />
            <directory name="examples/nexus-wallet-app/var" />
            <directory name="examples/nexus-wallet-app/tests" />
            <directory name="examples/nexus-wallet-app/perf" />
        </ignoreFiles>
    </projectFiles>

    <stubs>
        <!--
            Swoole ext is loaded at runtime via reflection when Psalm scans the
            whole project, but grumphp/pre-commit runs Psalm on individual
            staged files and can miss `Swoole\WebSocket\Frame` etc. Point at
            swoole/ide-helper so Psalm resolves those classes deterministically.
        -->
        <!-- Swoole\Coroutine\Server and Server\Connection live in swoole_library (pure PHP),
             not in swoole/ide-helper's native-ext stubs. Add them explicitly so Psalm
             resolves these classes when analyzing nexus-cluster-tcp/src/Swoole/.
             Client and Socket are native-ext classes; their stubs give Psalm the correct
             return types (e.g. Client::connect():bool, Client::exportSocket():Socket|false,
             Socket::recv():string|false) that the extension reflection alone does not always
             expose at Psalm's analysis time. -->
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/Coroutine/Client.php" />
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/Coroutine/Socket.php" />
        <file name="vendor/swoole/ide-helper/src/swoole_library/src/core/Coroutine/Server.php" />
        <file name="vendor/swoole/ide-helper/src/swoole_library/src/core/Coroutine/Server/Connection.php" />
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/WebSocket/Server.php" />
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/WebSocket/Frame.php" />
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/WebSocket/CloseFrame.php" />
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/Http/Server.php" />
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/Http/Request.php" />
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/Http/Response.php" />
        <!-- Swoole 6 thread mode: Pool/Runnable live in swoole_library (pure PHP);
             Thread/Map/Queue/Atomic are native-ext classes from the ide-helper stubs. -->
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/Thread.php" />
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/Thread/Atomic.php" />
        <!-- Replacement stubs: the vendor Map/ArrayList stubs implement ArrayAccess
             without @implements, so Psalm resolves their params to an unusable
             `TKey:ArrayAccess as mixed` template and flags every concrete key. -->
        <file name="stubs/Swoole/Thread/Map.php" />
        <file name="stubs/Swoole/Thread/ArrayList.php" />
        <file name="vendor/swoole/ide-helper/src/swoole/Swoole/Thread/Queue.php" />
        <file name="vendor/swoole/ide-helper/src/swoole_library/src/core/Thread/Pool.php" />
        <file name="vendor/swoole/ide-helper/src/swoole_library/src/core/Thread/Runnable.php" />
    </stubs>

    <plugins>
        <pluginClass class="Monadial\Nexus\Psalm\Plugin" />
    </plugins>

    <issueHandlers>
        <!-- PHP Fiber<T1,T2,T3,T4> has 4 template params which Psalm sees as excessive -->
        <TooManyTemplateParams errorLevel="suppress" />

        <!-- nexus-psalm necessarily uses Psalm's internal APIs as a plugin -->
        <InternalMethod>
            <errorLevel type="suppress">
                <directory name="packages/nexus-psalm/src" />
            </errorLevel>
        </InternalMethod>
        <InternalClass>
            <errorLevel type="suppress">
                <directory name="packages/nexus-psalm/src" />
            </errorLevel>
        </InternalClass>

        <!-- SwoolePeerLink::$clientOwner holds a Swoole\Coroutine\Client reference purely
             to prevent PHP's GC from running Client::__destruct(), which closes the
             underlying socket. The property is never read; holding it is the entire purpose. -->
        <UnusedProperty>
            <errorLevel type="suppress">
                <file name="packages/nexus-cluster-tcp/src/Swoole/SwoolePeerLink.php" />
            </errorLevel>
        </UnusedProperty>

        <PluginIssue name="UntypedActorRefInjection">
            <errorLevel type="suppress">
                <!-- Heterogeneous children/registry maps: one map holds refs with different message types; PHP has no per-key generics -->
                <file name="packages/nexus-core/src/Actor/ActorCell.php"/>
                <file name="packages/nexus-core/src/Actor/ActorSystem.php"/>
                <file name="packages/nexus-http/src/Actor/PerRequestActorScope.php"/>
                <file name="packages/nexus-http/src/Actor/ResolvedActorTable.php"/>
                <file name="packages/nexus-worker-pool/src/WorkerNode.php"/>
                <!-- Parent refs: a child cannot know its parent's message type -->
                <file name="packages/nexus-core/src/Actor/TaskContext.php"/>
                <!-- Watch/lifecycle plumbing: refs carried by identity, type erased by design (Akka Typed: ActorRef[Nothing]) -->
                <file name="packages/nexus-core/src/Lifecycle/ChildFailed.php"/>
                <file name="packages/nexus-core/src/Lifecycle/Terminated.php"/>
                <file name="packages/nexus-core/src/Message/DeadLetter.php"/>
                <file name="packages/nexus-core/src/Message/Unwatch.php"/>
                <file name="packages/nexus-core/src/Message/Watch.php"/>
                <!-- Sender ref in Envelope is carried by identity; the sender's message type is unknowable at the call site -->
                <file name="packages/nexus-core/src/Mailbox/Envelope.php"/>
                <!-- Reply-to pattern: the reply-to ref type cannot be known at the Effect level (Akka Typed: ActorRef[Nothing]) -->
                <file name="packages/nexus-persistence/src/EventSourced/Effect.php"/>
                <file name="packages/nexus-persistence/src/State/DurableEffect.php"/>
                <file name="packages/nexus-doctrine-orm/src/Behavior/EntityEffect.php"/>
                <!-- WebSocket connection table holds heterogeneous actor refs keyed by file descriptor -->
                <file name="packages/nexus-http-ws/src/WebSocket/ConnectionTable.php"/>
                <file name="packages/nexus-http-ws/src/WebSocket/InMemoryConnectionTable.php"/>
                <!-- Heterogeneous channel actor registry: different channel actor types have distinct command types -->
                <file name="packages/nexus-http-ws/src/WebSocket/ChannelActorRegistry.php"/>
                <!-- Entity ref cache: ActorRef<C> annotation is expressible but requires ActorSpawner::spawn() to carry the C template - out of scope for this PR -->
                <file name="packages/nexus-doctrine-orm/src/Behavior/EntityRefFactory.php"/>
                <!-- Timer scheduler infrastructure: the scheduled actor's message type is injected by ActorCell and not expressible at scheduler level -->
                <file name="packages/nexus-core/src/Actor/DefaultTimerScheduler.php"/>
                <!-- ReceiverActor / MessengerBridge: $deadLetters is a fan-in sink (any message type); $processedListener accepts MessagesProcessed — both are semantically typed but not expressible as a single concrete ActorRef<T> -->
                <file name="packages/nexus-messenger/src/Consumer/ReceiverActor.php"/>
                <file name="packages/nexus-messenger/src/MessengerBridge.php"/>
                <!-- StampMessageRouter: path-keyed registry (array<string, ActorRef>); the message type is unknowable per runtime path string (cluster routing seam) -->
                <file name="packages/nexus-messenger/src/Routing/StampMessageRouter.php"/>
                <!-- Skeleton Kernel: heterogeneous #[AsActor] auto-spawn registry built from config class-strings (same category as ActorSystem) -->
                <file name="packages/nexus-skeleton/src/Kernel.php"/>
                <!-- Cluster inbound routing: the local registry, delivery seam, and reply sender carry refs by identity; the remote caller's message type is not expressible at the routing boundary (Akka Typed: ActorRef[Nothing]) -->
                <file name="packages/nexus-cluster-tcp/src/Messaging/InboundDelivery.php"/>
                <file name="packages/nexus-cluster-tcp/src/Messaging/LocalActorRegistry.php"/>
                <file name="packages/nexus-cluster-tcp/src/Messaging/LocalDelivery.php"/>
                <!-- ClusterNode::$membershipRef accepts a heterogeneous union of membership messages; expose() takes any actor ref (typed by caller) -->
                <file name="packages/nexus-cluster-tcp/src/ClusterNode.php"/>
            </errorLevel>
        </PluginIssue>
    </issueHandlers>
</psalm>
