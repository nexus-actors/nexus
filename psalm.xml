<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="true"
    reportMixedIssues="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="packages/nexus-app/src" />
        <directory name="packages/nexus-cluster/src" />
        <directory name="packages/nexus-core/src" />
        <directory name="packages/nexus-doctrine-dbal/src" />
        <directory name="packages/nexus-doctrine-orm/src" />
        <directory name="packages/nexus-http/src" />
        <directory name="packages/nexus-http-auth/src" />
        <directory name="packages/nexus-http-server-swoole/src" />
        <directory name="packages/nexus-http-server-swoole-threads/src" />
        <directory name="packages/nexus-http-toolkit/src" />
        <directory name="packages/nexus-http-ws/src" />
        <directory name="packages/nexus-logger/src" />
        <directory name="packages/nexus-persistence/src" />
        <directory name="packages/nexus-persistence-dbal/src" />
        <directory name="packages/nexus-persistence-doctrine/src" />
        <directory name="packages/nexus-psalm/src" />
        <directory name="packages/nexus-runtime/src" />
        <directory name="packages/nexus-runtime-fiber/src" />
        <directory name="packages/nexus-runtime-step/src" />
        <directory name="packages/nexus-runtime-swoole/src" />
        <directory name="packages/nexus-serialization/src" />
        <directory name="packages/nexus-worker-pool/src" />
        <directory name="packages/nexus-worker-pool-swoole/src" />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="examples" />
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Monadial\Nexus\Psalm\Plugin" />
    </plugins>

    <issueHandlers>
        <!-- PHP Fiber<T1,T2,T3,T4> has 4 template params which Psalm sees as excessive -->
        <TooManyTemplateParams errorLevel="suppress" />

        <!-- nexus-psalm necessarily uses Psalm's internal APIs as a plugin -->
        <InternalMethod>
            <errorLevel type="suppress">
                <directory name="packages/nexus-psalm/src" />
            </errorLevel>
        </InternalMethod>
        <InternalClass>
            <errorLevel type="suppress">
                <directory name="packages/nexus-psalm/src" />
            </errorLevel>
        </InternalClass>

        <!-- WebSocket actor / handler base classes use abstract methods
             whose params are unused in the base impl; subclasses use them. -->
        <PossiblyUnusedParam>
            <errorLevel type="suppress">
                <directory name="packages/nexus-http-ws/src" />
                <directory name="packages/nexus-http-toolkit/src" />
            </errorLevel>
        </PossiblyUnusedParam>

        <!-- Logger Mdc methods are public API surface — Psalm can't see
             user-code calls. -->
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="packages/nexus-logger/src" />
                <directory name="packages/nexus-http-ws/src" />
            </errorLevel>
        </PossiblyUnusedMethod>
    </issueHandlers>
</psalm>
