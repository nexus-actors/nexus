<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>packages/nexus-core/tests/Unit</directory>
            <directory>packages/nexus-runtime-fiber/tests/Unit</directory>
            <directory>packages/nexus-runtime-step/tests/Unit</directory>
            <directory>packages/nexus-runtime-swoole/tests/Unit</directory>
            <directory>packages/nexus-serialization/tests/Unit</directory>
            <directory>packages/nexus-cluster/tests/Unit</directory>
            <directory>packages/nexus-cluster-swoole/tests/Unit</directory>
            <directory>packages/nexus-app/tests/Unit</directory>
            <directory>packages/nexus-persistence/tests/Unit</directory>
            <directory>packages/nexus-persistence-dbal/tests/Unit</directory>
        </testsuite>
        <testsuite name="integration-fiber">
            <directory>tests/Integration/Fiber</directory>
        </testsuite>
        <testsuite name="integration-swoole">
            <directory>tests/Integration/Swoole</directory>
        </testsuite>
        <testsuite name="integration-step">
            <directory>tests/Integration/Step</directory>
        </testsuite>
        <testsuite name="integration-serialization">
            <directory>tests/Integration/Serialization</directory>
        </testsuite>
        <testsuite name="integration-cluster">
            <directory>tests/Integration/Cluster</directory>
        </testsuite>
        <testsuite name="unit-persistence">
            <directory>packages/nexus-persistence/tests/Unit</directory>
        </testsuite>
        <testsuite name="unit-persistence-dbal">
            <directory>packages/nexus-persistence-dbal/tests/Unit</directory>
        </testsuite>
        <testsuite name="integration-persistence">
            <directory>tests/Integration/Persistence</directory>
        </testsuite>
        <testsuite name="performance">
            <directory>tests/Performance</directory>
        </testsuite>
        <testsuite name="psalm">
            <directory>packages/nexus-psalm/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/nexus-core/src</directory>
            <directory>packages/nexus-runtime-fiber/src</directory>
            <directory>packages/nexus-runtime-step/src</directory>
            <directory>packages/nexus-runtime-swoole/src</directory>
            <directory>packages/nexus-serialization/src</directory>
            <directory>packages/nexus-cluster/src</directory>
            <directory>packages/nexus-cluster-swoole/src</directory>
            <directory>packages/nexus-app/src</directory>
            <directory>packages/nexus-persistence/src</directory>
            <directory>packages/nexus-persistence-dbal/src</directory>
        </include>
    </source>
</phpunit>