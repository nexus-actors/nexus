            <directory>packages/nexus-observability-serialization/tests/Unit</directory>
            <directory>packages/nexus-observability-worker-pool/tests/Unit</directory>
            <directory>packages/nexus-observability-doctrine/tests/Unit</directory>
        </testsuite>
        <testsuite name="unit-swoole">
            <directory>packages/nexus-runtime-swoole/tests/Unit</directory>
