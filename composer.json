{
    "name": "monadial/nexus-monorepo",
    "description": "Nexus — A production-grade actor system for PHP 8.5+",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "azjezz/psl": "^4.0",
        "brick/math": "^0.12",
        "cuyz/valinor": "^1.0",
        "fp4php/functional": "^6.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "shipmonk/phpstan-rules": "^4.0",
        "shipmonk/phpstan-dev": "^0.1",
        "infection/infection": "^0.32",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "files": [
            "packages/nexus-core/src/Actor/Functions/functions.php"
        ],
        "psr-4": {
            "Monadial\\Nexus\\Core\\": "packages/nexus-core/src/",
            "Monadial\\Nexus\\Runtime\\Fiber\\": "packages/nexus-runtime-fiber/src/",
            "Monadial\\Nexus\\Runtime\\Swoole\\": "packages/nexus-runtime-swoole/src/",
            "Monadial\\Nexus\\Serialization\\": "packages/nexus-serialization/src/",
            "Monadial\\Nexus\\PHPStan\\": "packages/nexus-phpstan/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Monadial\\Nexus\\Core\\Tests\\": "packages/nexus-core/tests/",
            "Monadial\\Nexus\\Runtime\\Fiber\\Tests\\": "packages/nexus-runtime-fiber/tests/",
            "Monadial\\Nexus\\Runtime\\Swoole\\Tests\\": "packages/nexus-runtime-swoole/tests/",
            "Monadial\\Nexus\\Serialization\\Tests\\": "packages/nexus-serialization/tests/",
            "Monadial\\Nexus\\PHPStan\\Tests\\": "packages/nexus-phpstan/tests/",
            "Monadial\\Nexus\\Tests\\Integration\\": "tests/Integration/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
